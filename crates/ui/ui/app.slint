    in-out property <int> launcher-visibility-index: 2; // 0=关闭 1=隐藏 2=保持 3=隐藏后重开
    in-out property <bool> debug-log-overridden: false;
    in-out property <bool> debug-log: false;

    in-out property <bool> running-directory-overridden: false;
    in-out property <string> running-directory: "";
    in-out property <bool> game-arguments-overridden: false;
    in-out property <string> game-arguments: "";
    in-out property <bool> environment-variables-overridden: false;
    in-out property <string> environment-variables: "";
    in-out property <bool> command-wrapper-overridden: false;
    in-out property <string> command-wrapper: "";
    in-out property <bool> pre-launch-command-overridden: false;
    in-out property <string> pre-launch-command: "";
    in-out property <bool> post-exit-command-overridden: false;
    in-out property <string> post-exit-command: "";
    in-out property <bool> process-priority-overridden: false;
    in-out property <int> process-priority-index: 2; // 0=低 1=低于正常 2=正常 3=高于正常 4=高
    in-out property <bool> graphics-backend-overridden: false;
    in-out property <int> graphics-backend-index: 0; // 0=默认 1=OpenGL 2=Vulkan
    in-out property <bool> use-custom-natives-overridden: false;
    in-out property <bool> use-custom-natives: false;
    in-out property <bool> natives-directory-overridden: false;
    in-out property <string> natives-directory: "";

    property <string> inherited-java-version: root.global-java-index == 1 ? "8"
        : (root.global-java-index == 2 ? "17" : (root.global-java-index == 3 ? "21" : ""));
    property <int> inherited-java-type-index: root.global-java-index == 4 ? 2
        : (root.global-java-index == 0 ? 0 : 1);
    property <bool> quick-play-matches-global: root.quick-play-index == root.global-quick-play-index
        && (root.quick-play-index == 0
            || (root.quick-play-index == 1 && root.quick-play-multiplayer == root.global-quick-play-multiplayer)
            || (root.quick-play-index == 2 && root.quick-play-singleplayer == root.global-quick-play-singleplayer)
            || (root.quick-play-index == 3 && root.quick-play-realms == root.global-quick-play-realms));

    function schedule-instance-settings-save() {
        if !root.settings-syncing && root.settings-instance-id != "" {
            if settings-autosave.running {
                settings-autosave.restart();
            } else {
                settings-autosave.start();
            }
        }
    }

    settings-autosave := Timer {
        interval: 180ms;
        running: false;
        triggered() => {
            root.save-instance-settings();
            self.stop();
        }
    }

    changed java-type-overridden => { root.schedule-instance-settings-save(); }
