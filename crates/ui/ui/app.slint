    // 每个字段一对: `*-overridden` 对应 `overrideProperties` 里有没有这个属性名,
    // 值本身只在 overridden 时才可编辑/生效。跟 HMCL-java 的属性双向绑定一样，
    // 用户改动后自动落盘；settings-syncing 防止 Rust 打开页面、批量填值时误保存。
    in-out property <string> settings-instance-id: "";
    property <bool> instance-menu-open: false;
    property <bool> instance-menu-revealed: false;
    property <int> instance-menu-page: 0;
    property <string> instance-menu-input: "";
    property <string> instance-menu-export-name: "";
    property <string> instance-menu-export-version: "1.0";
    property <string> instance-menu-export-summary: "";
    property <int> instance-menu-cleanup-kind: 0;
    property <length> instance-menu-x: 0px;
    property <length> instance-menu-y: 0px;
    function reveal-instance-menu() {
        root.instance-menu-revealed = false;
        root.instance-menu-open = true;
        instance-menu-open-timer.start();
    }
    function dismiss-instance-menu() {
        root.instance-menu-revealed = false;
        instance-menu-close-timer.start();
    }
    in-out property <bool> settings-syncing: false;
    property <bool> settings-java-expanded: false;
    property <bool> settings-memory-expanded: false;
    property <bool> settings-window-expanded: false;
    property <bool> settings-quickplay-expanded: false;
    property <bool> settings-advanced-expanded: false;
    property <bool> settings-deprecated-memory-expanded: false;

    in-out property <bool> java-type-overridden: false;
    in-out property <int> java-type-index: 0; // 0=自动 1=指定版本 2=自定义路径
    in-out property <bool> custom-java-version-overridden: false;
    in-out property <string> custom-java-version: "";
    in-out property <bool> custom-java-path-overridden: false;
    in-out property <string> custom-java-path: "";
    in-out property <bool> jvm-options-overridden: false;
    in-out property <string> jvm-options: "";
    in-out property <bool> no-jvm-options-overridden: false;
    in-out property <bool> no-jvm-options: false;
    in-out property <bool> no-optimizing-jvm-options-overridden: false;
    in-out property <bool> no-optimizing-jvm-options: false;
    in-out property <bool> not-check-jvm-overridden: false;
    in-out property <bool> not-check-jvm: false;

    in-out property <bool> auto-memory-overridden: false;
    in-out property <bool> auto-memory: true;
    in-out property <bool> max-memory-overridden: false;
    in-out property <string> max-memory: "2048";
    in-out property <bool> min-memory-overridden: false;
    in-out property <string> min-memory: "";
    in-out property <bool> perm-size-overridden: false;
    in-out property <string> perm-size: "";

    in-out property <bool> window-type-overridden: false;
    in-out property <int> window-type-index: 0; // 0=窗口化 1=全屏 2=最大化
    in-out property <bool> width-overridden: false;
    in-out property <string> settings-width: "1280";
    in-out property <bool> height-overridden: false;
    in-out property <string> settings-height: "720";

    in-out property <bool> quick-play-overridden: false;
    in-out property <int> quick-play-index: 0; // 0=无 1=多人 2=单人 3=Realms
    in-out property <string> quick-play-multiplayer: "";
    in-out property <string> quick-play-singleplayer: "";
    in-out property <string> quick-play-realms: "";

