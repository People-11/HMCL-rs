    function switch-world-detail-tab(next-tab: int) {
        if root.world-detail-tab-phase == 0 && next-tab != root.world-detail-tab {
            if root.animation-disabled {
                root.world-detail-tab = next-tab;
                if next-tab == 1 { root.refresh-world-backups(); }
                if next-tab == 2 { root.refresh-world-datapacks(); }
                return;
            }
            root.world-detail-tab-forward = next-tab > root.world-detail-tab;
            root.world-detail-tab-target = next-tab;
            root.world-detail-tab-phase = 1;
            world-detail-tab-midpoint.start();
        }
    }
    world-detail-tab-midpoint := Timer {
        interval: 100ms;
        triggered => {
            root.world-detail-tab = root.world-detail-tab-target;
            if root.world-detail-tab == 1 { root.refresh-world-backups(); }
            if root.world-detail-tab == 2 { root.refresh-world-datapacks(); }
            root.world-detail-tab-phase = 2;
            self.stop();
            world-detail-tab-next-frame.start();
        }
    }
    world-detail-tab-next-frame := Timer {
        interval: 16ms;
        triggered => {
            root.world-detail-tab-phase = 3;
            self.stop();
            world-detail-tab-finished.start();
        }
    }
    world-detail-tab-finished := Timer {
        interval: 100ms;
        triggered => {
            root.world-detail-tab-phase = 0;
            self.stop();
        }
    }
    property <bool> content-page-loading: root.instance-tab == 5 ? root.world-loading : root.instance-content-loading;
    property <int> content-page-count: root.instance-tab == 5 ? root.world-items.length : root.instance-content-items.length;

    function switch-instance-tab(next-tab: int) {
        if root.instance-tab-phase == 0 && next-tab != root.instance-tab {
            if root.animation-disabled {
                root.instance-tab = next-tab;
                if next-tab != 0 { root.refresh-instance-content(next-tab); }
                return;
            }
            root.instance-tab-forward = next-tab > root.instance-tab;
            root.instance-tab-target = next-tab;
            root.instance-tab-phase = 1;
            instance-tab-midpoint.start();
        }
    }

    instance-tab-midpoint := Timer {
        interval: 100ms;
        triggered() => {
            root.instance-tab = root.instance-tab-target;
            if root.instance-tab != 0 { root.refresh-instance-content(root.instance-tab); }
            root.instance-tab-phase = 2;
            self.stop();
            instance-tab-next-frame.start();
        }
    }
    instance-tab-next-frame := Timer {
        interval: 16ms;
        triggered() => {
            root.instance-tab-phase = 3;
            self.stop();
            instance-tab-finished.start();
        }
    }
    instance-tab-finished := Timer {
        interval: 100ms;
        triggered() => {
            root.instance-tab-phase = 0;
            self.stop();
        }
    }
