        interval: 100ms;
        triggered() => {
            root.settings-tab-phase = 0;
            self.stop();
        }
    }

    function schedule-launcher-settings-save() {
        if !root.launcher-settings-syncing {
            if launcher-settings-autosave.running {
                launcher-settings-autosave.restart();
            } else {
                launcher-settings-autosave.start();
            }
        }
    }
    launcher-settings-autosave := Timer {
        interval: 180ms;
        triggered() => {
            root.save-launcher-settings();
            self.stop();
        }
    }

    changed titlebar-transparent => { root.schedule-launcher-settings-save(); }
    changed animation-disabled => { root.schedule-launcher-settings-save(); }
    changed version-source-index => { root.schedule-launcher-settings-save(); }
    changed file-source-index => { root.schedule-launcher-settings-save(); }
    changed auto-download-threads => { root.schedule-launcher-settings-save(); }
    changed download-threads => { root.schedule-launcher-settings-save(); }

    function schedule-global-settings-save() {
