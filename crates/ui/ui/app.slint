    property <string> selected-instance-id: root.selected-instance-index >= 0 && root.selected-instance-index < root.instances.length ? root.instances[root.selected-instance-index].id : "";
    property <string> selected-account-name: root.selected-account-index >= 0 && root.selected-account-index < root.accounts.length ? root.accounts[root.selected-account-index] : "";
    property <bool> show-instance-picker: false;
    property <int> renaming-index: -1;
    property <int> delete-confirm-index: -1;
    property <bool> game-directory-menu-open: false;
    property <bool> game-directory-menu-revealed: false;
    property <int> game-directory-menu-index: -1;
    property <string> game-directory-menu-name: "";
    property <bool> game-directory-menu-can-delete: false;
    property <length> navigation-sidebar-width: 190px;
    property <length> game-directory-menu-y: 0;
    property <int> game-directory-menu-page: 0;
    property <string> game-directory-menu-input: "";
    in-out property <bool> show-crash-dialog: false;
    property <bool> crash-dialog-mounted: false;
    property <bool> crash-dialog-visible: false;
    in-out property <string> crash-instance-name: "";
    in-out property <string> crash-exit-code: "";
    in-out property <string> crash-log: "";
    in-out property <string> crash-log-folder: "";

    property <bool> account-dialog-mounted: false;
    property <bool> account-dialog-visible: false;
    property <string> account-dialog-username: "";
    property <bool> account-dialog-advanced: false;
    property <float> account-dialog-advanced-progress: root.account-dialog-advanced ? 1 : 0;
    animate account-dialog-advanced-progress { duration: 200ms; easing: ease; }
    property <string> account-dialog-uuid: "";
    property <string> account-dialog-derived-uuid: "";
    property <bool> account-dialog-uuid-valid: true;
    in-out property <bool> microsoft-dialog-mounted: false;
    in-out property <bool> microsoft-dialog-visible: false;
    in-out property <int> microsoft-login-state: 0;
    in-out property <string> microsoft-login-code: "";
    in-out property <string> microsoft-login-url: "";
    in-out property <string> microsoft-login-message: "";
    in-out property <bool> authlib-dialog-mounted: false;
    in-out property <bool> authlib-dialog-visible: false;
    in-out property <int> authlib-dialog-state: 0;
    in-out property <int> authlib-server-index: -1;
    in-out property <string> authlib-server-url: "";
    in-out property <string> authlib-server-name: "";
    in-out property <bool> authlib-server-insecure: false;
    in-out property <string> authlib-login-name: "";
    in-out property <string> authlib-login-password: "";
    in-out property <string> authlib-login-message: "";
    in property <[string]> authlib-profile-names;
    property <bool> install-progress-dialog-mounted: false;
    property <bool> install-progress-dialog-visible: false;
    property <bool> mod-version-dialog-mounted: false;
    property <bool> mod-version-dialog-visible: false;
    property <bool> copyright-dialog-mounted: false;
    property <bool> copyright-dialog-visible: false;

    changed account-dialog-username => {
        root.account-dialog-derived-uuid = root.derive-offline-uuid(root.account-dialog-username);
    }
    changed account-dialog-uuid => {
        root.account-dialog-uuid-valid = root.account-dialog-uuid == "" || root.valid-uuid(root.account-dialog-uuid);
    }
    show-account-page => { root.navigate-to(2, 0); }
    show-instance-list => { root.navigate-to(1, 2); }

    function open-account-dialog() {
        account-dialog-close-finished.stop();
        root.account-dialog-mounted = true;
        root.account-dialog-visible = false;
        root.account-dialog-derived-uuid = root.derive-offline-uuid(root.account-dialog-username);
        account-dialog-show-frame.start();
    }

    function open-copyright-dialog() {
        copyright-dialog-close-finished.stop();
        root.copyright-dialog-mounted = true;
        root.copyright-dialog-visible = false;
        copyright-dialog-show-frame.start();
    }

    function close-copyright-dialog() {
        if root.copyright-dialog-mounted {
            copyright-dialog-show-frame.stop();
            root.copyright-dialog-visible = false;
            copyright-dialog-close-finished.start();
        }
    }

    function reveal-game-directory-menu() {
        root.game-directory-menu-revealed = false;
        root.game-directory-menu-open = true;
        game-directory-menu-open-timer.start();
    }

    function dismiss-game-directory-menu() {
        root.game-directory-menu-revealed = false;
        game-directory-menu-close-timer.start();
    }

    function open-microsoft-dialog() {
        microsoft-dialog-close-finished.stop();
        root.microsoft-login-state = 0;
        root.microsoft-login-code = "";
        root.microsoft-login-url = "";
        root.microsoft-login-message = "正在连接 Microsoft…";
        root.microsoft-dialog-mounted = true;
        root.microsoft-dialog-visible = false;
        microsoft-dialog-show-frame.start();
        root.begin-microsoft-login();
    }

    function open-add-auth-server-dialog() {
        authlib-dialog-close-finished.stop();
        root.authlib-dialog-state = 0;
        root.authlib-server-index = -1;
        root.authlib-server-url = "";
        root.authlib-server-name = "";
        root.authlib-login-message = "";
        root.authlib-dialog-mounted = true;
        root.authlib-dialog-visible = false;
        authlib-dialog-show-frame.start();
    }

    function open-authlib-login-dialog(index: int) {
        if index >= 0 && index < root.auth-server-names.length {
            authlib-dialog-close-finished.stop();
            root.authlib-dialog-state = 2;
            root.authlib-server-index = index;
            root.authlib-server-name = root.auth-server-names[index];
            root.authlib-server-url = root.auth-server-urls[index];
            root.authlib-login-name = "";
            root.authlib-login-password = "";
            root.authlib-login-message = "";
            root.authlib-dialog-mounted = true;
            root.authlib-dialog-visible = false;
            authlib-dialog-show-frame.start();
        }
    }

    public function close-authlib-dialog() {
        if root.authlib-dialog-mounted {
            root.cancel-authlib-login();
            root.authlib-login-password = "";
            authlib-dialog-show-frame.stop();
            root.authlib-dialog-visible = false;
            authlib-dialog-close-finished.start();
        }
    }

    function close-microsoft-dialog() {
        if root.microsoft-dialog-mounted {
            root.cancel-microsoft-login();
            microsoft-dialog-show-frame.stop();
            root.microsoft-dialog-visible = false;
            microsoft-dialog-close-finished.start();
        }
    }

    function close-account-dialog() {
        if root.account-dialog-mounted {
            account-dialog-show-frame.stop();
            root.account-dialog-visible = false;
            account-dialog-close-finished.start();
        }
    }
    function submit-account-dialog() {
        if root.account-dialog-username != "" && root.account-dialog-uuid-valid {
            root.add-account(root.account-dialog-username, root.account-dialog-uuid);
            root.close-account-dialog();
        }
    }

    account-dialog-show-frame := Timer {
        interval: 16ms;
        running: false;
        triggered() => {
            root.account-dialog-visible = true;
            self.stop();
        }
    }
    account-dialog-close-finished := Timer {
        interval: 200ms;
        running: false;
        triggered() => {
            root.account-dialog-mounted = false;
            self.stop();
        }
    }
    copyright-dialog-show-frame := Timer {
        interval: 16ms;
        running: false;
        triggered() => {
            root.copyright-dialog-visible = true;
            self.stop();
        }
    }
    copyright-dialog-close-finished := Timer {
        interval: 200ms;
        running: false;
        triggered() => {
            root.copyright-dialog-mounted = false;
            self.stop();
        }
    }
    changed show-crash-dialog => {
        if root.show-crash-dialog {
            crash-dialog-close-finished.stop();
            root.crash-dialog-mounted = true;
            root.crash-dialog-visible = false;
            crash-dialog-show-frame.start();
        } else if root.crash-dialog-mounted {
            crash-dialog-show-frame.stop();
            root.crash-dialog-visible = false;
            crash-dialog-close-finished.start();
        }
    }
    crash-dialog-show-frame := Timer {
        interval: 16ms;
        triggered() => {
            root.crash-dialog-visible = true;
            self.stop();
        }
    }
    crash-dialog-close-finished := Timer {
        interval: 200ms;
        triggered() => {
            root.crash-dialog-mounted = false;
            self.stop();
        }
    }
    microsoft-dialog-show-frame := Timer {
        interval: 16ms;
        triggered() => {
            root.microsoft-dialog-visible = true;
            self.stop();
        }
    }
    microsoft-dialog-close-finished := Timer {
        interval: 200ms;
        triggered() => {
            root.microsoft-dialog-mounted = false;
            self.stop();
        }
    }
    authlib-dialog-show-frame := Timer {
        interval: 16ms;
        triggered() => {
            root.authlib-dialog-visible = true;
            self.stop();
        }
    }
    authlib-dialog-close-finished := Timer {
        interval: 200ms;
        triggered() => {
            root.authlib-dialog-mounted = false;
            self.stop();
        }
    }

    changed show-install-progress => {
        if root.show-install-progress {
            install-progress-close-finished.stop();
            root.install-succeeded = false;
            root.install-progress-dialog-mounted = true;
            root.install-progress-dialog-visible = false;
            install-progress-show-frame.start();
        } else if root.install-progress-dialog-mounted {
            install-progress-show-frame.stop();
            root.install-progress-dialog-visible = false;
            install-progress-close-finished.start();
        }
    }
    install-progress-show-frame := Timer {
        interval: 16ms;
        running: false;
        triggered() => {
            root.install-progress-dialog-visible = true;
            self.stop();
        }
    }
    install-progress-close-finished := Timer {
        interval: 200ms;
        running: false;
        triggered() => {
            root.install-progress-dialog-mounted = false;
            self.stop();
        }
    }
    changed show-mod-version-dialog => {
        if root.show-mod-version-dialog {
            mod-version-dialog-close-finished.stop();
            root.mod-version-dialog-mounted = true;
            root.mod-version-dialog-visible = false;
            mod-version-dialog-show-frame.start();
        } else if root.mod-version-dialog-mounted {
            mod-version-dialog-show-frame.stop();
            root.mod-version-dialog-visible = false;
            mod-version-dialog-close-finished.start();
        }
    }
    mod-version-dialog-show-frame := Timer {
        interval: 16ms;
        triggered() => {
            root.mod-version-dialog-visible = true;
            self.stop();
        }
    }
    mod-version-dialog-close-finished := Timer {
        interval: 200ms;
        triggered() => {
            root.mod-version-dialog-mounted = false;
            self.stop();
        }
    }
    changed show-launch-progress => {
        if root.show-launch-progress {
            launch-progress-close-finished.stop();
            root.launch-progress-dialog-mounted = true;
            root.launch-progress-dialog-visible = false;
            launch-progress-show-frame.start();
        } else if root.launch-progress-dialog-mounted {
            launch-progress-show-frame.stop();
            root.launch-progress-dialog-visible = false;
            launch-progress-close-finished.start();
        }
    }
    launch-progress-show-frame := Timer {
        interval: 16ms;
        triggered() => {
            root.launch-progress-dialog-visible = true;
            self.stop();
        }
    }
    launch-progress-close-finished := Timer {
        interval: 200ms;
        triggered() => {
            root.launch-progress-dialog-mounted = false;
            self.stop();
        }
    }

    background: #e9ecf7;

    Image {
        source: @image-url("assets/wallpaper.jpg");
        width: 100%;
        height: 100%;
        image-fit: cover;
    }

    VerticalLayout {
        Rectangle {
            height: 42.667px;
            background: root.titlebar-transparent ? #eef1f89e : #767bdf;
            animate background { duration: 120ms; }

            titlebar-drag := TouchArea {
                moved => {
                    if self.pressed {
                        root.window-drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
            }

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: (parent.height - 28px) / 2;
                padding-right: (parent.height - 28px) / 2;
                spacing: 2px;

                if root.page == 0: Rectangle {
                    width: min(250px, parent.width - 68px);
                    title-home := HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 10px;
                        alignment: start;
                        states [
                            next-out when root.page-transition-phase == 1 && root.page-transition-kind != 2 && root.page-transition-kind != 3: {
                                x: -50px;
                                opacity: 0;
                                in { animate x, opacity { duration: 100ms; easing: ease; } }
                            }
                            next-in when root.page-transition-phase == 2 && root.page-transition-kind != 2 && root.page-transition-kind != 3: {
                                x: 50px;
                                opacity: 0;
                                out { animate x, opacity { duration: 100ms; easing: ease; } }
                            }
                            previous-out when root.page-transition-phase == 1 && (root.page-transition-kind == 2 || root.page-transition-kind == 3): {
                                x: 50px;
                                opacity: 0;
                                in { animate x, opacity { duration: 100ms; easing: ease; } }
                            }
                            previous-in when root.page-transition-phase == 2 && (root.page-transition-kind == 2 || root.page-transition-kind == 3): {
                                x: -50px;
                                opacity: 0;
                                out { animate x, opacity { duration: 100ms; easing: ease; } }
                            }
                        ]
                        Image { source: @image-url("assets/icon.png"); width: 22px; height: 22px; y: (parent.height - self.height) / 2; }
                        Text {
                            text: "HMCL-rs";
                            color: root.titlebar-transparent ? #302e37 : white;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.page != 0: Rectangle {
                    width: min(430px, parent.width - 68px);
                    title-page := HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 2px;
                        alignment: start;
                        states [
                            next-out when root.page-transition-phase == 1 && root.page-transition-kind != 2 && root.page-transition-kind != 3: {
                                x: -50px;
                                opacity: 0;
                                in { animate x, opacity { duration: 100ms; easing: ease; } }
                            }
                            next-in when root.page-transition-phase == 2 && root.page-transition-kind != 2 && root.page-transition-kind != 3: {
                                x: 50px;
                                opacity: 0;
                                out { animate x, opacity { duration: 100ms; easing: ease; } }
                            }
                            previous-out when root.page-transition-phase == 1 && (root.page-transition-kind == 2 || root.page-transition-kind == 3): {
                                x: 50px;
                                opacity: 0;
                                in { animate x, opacity { duration: 100ms; easing: ease; } }
                            }
                            previous-in when root.page-transition-phase == 2 && (root.page-transition-kind == 2 || root.page-transition-kind == 3): {
                                x: -50px;
                                opacity: 0;
                                out { animate x, opacity { duration: 100ms; easing: ease; } }
                            }
                        ]
                        TitleBarButton {
                            icon-path: Icons.arrow-back;
                            dark-foreground: root.titlebar-transparent;
                            clicked => {
                                if root.page == 5 {
                                    root.navigate-to(root.loader-picker-instance-mode ? 6 : 4, 2);
                                } else if root.page == 4 {
                                    root.navigate-to(3, 2);
                                } else if root.page == 6 {
                                    root.navigate-to(1, 2);
                                } else if root.page == 7 {
                                    root.navigate-to(root.settings-return-page, 2);
                                } else if root.page == 8 {
                                    root.navigate-to(6, 2);
                                } else if root.page == 3 && root.mod-detail-open {
                                    root.mod-detail-open = false;
                                    root.show-mod-version-dialog = false;
                                } else if root.page == 3 && root.download-return-instance {
                                    root.download-return-instance = false;
                                    root.navigate-to(6, 2);
                                } else {
                                    root.navigate-to(0, 3);
                                }
                            }
                        }
                        if root.page == 4: TitleBarButton {
                            icon-path: Icons.close;
                            dark-foreground: root.titlebar-transparent;
                            clicked => { root.navigate-to(3, 2); }
                        }
                        if root.page == 3: TitleBarButton {
                            icon-path: Icons.home;
                            dark-foreground: root.titlebar-transparent;
                            clicked => {
                                root.mod-detail-open = false;
                                root.show-mod-version-dialog = false;
                                root.download-return-instance = false;
                                root.navigate-to(0, 3);
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            padding-left: 2px;
                            Text {
                                text: root.page == 1 ? "实例列表"
                                    : (root.page == 2 ? "账户列表"
                                    : (root.page == 3 ? (root.mod-detail-open ? root.mod-detail-title : "下载")
                                    : (root.page == 4 ? "安装新游戏 - " + root.install-game-version
                                    : (root.page == 5 ? (root.loader-picker-instance-mode ? "实例管理" : "安装新游戏") + " - 选择 " + root.loader-names[root.loader-picker-kind] + " 版本"
                                    : (root.page == 6 ? "实例管理 - " + root.settings-instance-id
                                    : (root.page == 8 ? "世界 - " + root.world-detail-name
                                    : "设置"))))));
                                color: root.titlebar-transparent ? #302e37 : white;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                TitleBarButton {
                    icon-path: Icons.help;
                    dark-foreground: root.titlebar-transparent;
                    clicked => { root.open-copyright-dialog(); }
                }
                TitleBarButton {
                    icon-path: Icons.minimize;
                    dark-foreground: root.titlebar-transparent;
                    clicked => { root.window-minimize(); }
                }
                TitleBarButton {
                    icon-path: Icons.close;
                    dark-foreground: root.titlebar-transparent;
                    clicked => { root.window-close(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            body-motion := HorizontalLayout {
                width: 100%;
                height: 100%;
                states [
                    navigation-out when root.page-transition-phase == 1 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                        opacity: 0;
                        in { animate opacity { duration: 100ms; easing: ease; } }
                    }
                    navigation-in when root.page-transition-phase == 2 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                        opacity: 0;
                        out { animate opacity { duration: 100ms; easing: ease; } }
                    }
                    forward-out when root.page-transition-phase == 1 && root.page-transition-kind == 1: {
                        x: -152px;
                        opacity: 0;
                        in { animate x, opacity { duration: 100ms; easing: ease; } }
                    }
                    forward-in when root.page-transition-phase == 2 && root.page-transition-kind == 1: {
                        x: 152px;
                        opacity: 0;
                        out { animate x, opacity { duration: 100ms; easing: ease; } }
                    }
                    backward-out when root.page-transition-phase == 1 && root.page-transition-kind == 2: {
                        x: 152px;
                        opacity: 0;
                        in { animate x, opacity { duration: 100ms; easing: ease; } }
                    }
                    backward-in when root.page-transition-phase == 2 && root.page-transition-kind == 2: {
                        x: -152px;
                        opacity: 0;
                        out { animate x, opacity { duration: 100ms; easing: ease; } }
                    }
                ]
            if root.page <= 3 || root.page == 6 || root.page == 7 || root.page == 8: navigation-sidebar := Rectangle {
                width: root.page == 3 && root.mod-detail-open ? 0px : root.navigation-sidebar-width;
                background: #eef1f89e;
                clip: true;
                animate width { duration: 100ms; easing: ease; }

                // 当前页面是这一层唯一的伸展项；页面内部需要贴底的菜单由一个
                // vertical-stretch 空白承接余量，普通分组仍显式 start，避免拉大文字间距。
                VerticalLayout {
                    padding: 14px;
                    spacing: 18px;
                    states [
                        navigation-out when root.page-transition-phase == 1 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: -30px;
                            in { animate x { duration: 100ms; easing: ease; } }
                        }
                        navigation-in when root.page-transition-phase == 2 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: -30px;
                            out { animate x { duration: 100ms; easing: ease; } }
                        }
                    ]

                    if root.page == 0: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 18px;
                        alignment: start;

                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            NavGroupLabel { text: "账户"; }
                            Rectangle { height: 1phx; background: #55597a; }
                            NavItem {
                                icon-path: Icons.person;
                                title: root.selected-account-name == "" ? "没有游戏账户" : root.selected-account-name;
                                subtitle: root.selected-account-name == "" ? "点击此处添加账户" : "";
                                clicked => { root.navigate-to(2, 0); }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            NavGroupLabel { text: "游戏"; }
                            Rectangle { height: 1phx; background: #55597a; }
                            NavItem {
                                icon-path: Icons.gamepad;
                                title: root.selected-instance-id == "" ? "没有游戏实例" : "实例管理";
                                subtitle: root.selected-instance-id == "" ? "进入下载页安装游戏" : root.selected-instance-id;
                                clicked => {
                                    if root.selected-instance-id == "" {
                                        root.navigate-to(1, 0);
                                    } else {
                                        root.open-instance-settings(root.selected-instance-id);
                                        root.navigate-to(6, 1);
                                    }
                                }
                            }
                            NavItem { icon-path: Icons.list; title: "实例列表"; subtitle: ""; clicked => { root.navigate-to(1, 0); } }
                            NavItem {
                                icon-path: Icons.download;
                                title: "下载";
                                subtitle: "";
                                clicked => {
                                    root.download-return-instance = false;
                                    root.navigate-to(3, 0);
                                    if root.remote-versions.length == 0 { root.refresh-remote-versions(); }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            NavGroupLabel { text: "通用"; }
                            Rectangle { height: 1phx; background: #55597a; }
                            NavItem {
                                icon-path: Icons.settings;
                                title: "设置";
                                subtitle: "";
                                clicked => {
                                    root.settings-return-page = 0;
                                    root.settings-tab = 3;
                                    root.navigate-to(7, 0);
                                }
                            }
                        }
                    }

                    if root.page == 1: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 6px;
                        NavGroupLabel { text: "当前文件夹"; }
                        Rectangle { height: 1phx; background: #55597a; }
                        ListView {
                            vertical-stretch: 1;
                            for directory[i] in root.game-directories: GameDirectoryNavItem {
                                title: directory.name;
                                path: directory.path;
                                selected: i == root.selected-game-directory-index;
                                clicked => { root.select-game-directory(i); }
                                more-clicked(y) => {
                                    root.game-directory-menu-index = i;
                                    root.game-directory-menu-name = directory.name;
                                    root.game-directory-menu-can-delete =
                                        root.game-directories.length > 1;
                                    root.game-directory-menu-input = directory.name;
                                    root.game-directory-menu-page = 0;
                                    root.game-directory-menu-y = y;
                                    root.reveal-game-directory-menu();
                                }
                            }
                        }
                        NavItem {
                            icon-path: Icons.download;
                            title: "安装新游戏";
                            subtitle: "";
                            clicked => {
                                root.download-return-instance = false;
                                root.download-section = 0;
                                root.download-tab = 0;
                                root.navigate-to(3, 0);
                                if root.remote-versions.length == 0 { root.refresh-remote-versions(); }
                            }
                        }
                        NavItem {
                            icon-path: Icons.add;
                            title: "添加文件夹";
                            subtitle: "";
                            clicked => { root.add-game-directory(); }
                        }
                        NavItem {
                            icon-path: Icons.package2;
                            title: "安装整合包";
                            subtitle: "";
                            clicked => {
                                root.download-return-instance = false;
                                root.download-section = 1;
                                root.navigate-to(3, 0);
                                root.download-tab = 1;
                                root.mod-search-kind = 3;
                                root.mod-category-index = 0;
                                root.search-mods();
                            }
                        }
                        NavItem {
                            icon-path: Icons.settings;
                            title: "全局游戏设置";
                            subtitle: "";
                            clicked => {
                                root.settings-return-page = 1;
                                root.settings-tab = 0;
                                root.navigate-to(7, 0);
                            }
                        }
                    }

                    if root.page == 2: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 6px;
                        NavGroupLabel { text: "添加账户"; }
                        Rectangle { height: 1phx; background: #55597a; }
                        NavItem { icon-path: Icons.person; title: "微软账户"; subtitle: ""; clicked => { root.open-microsoft-dialog(); } }
                        NavItem {
                            icon-path: Icons.person;
                            title: "离线模式";
                            subtitle: "";
                            clicked => {
                                root.account-dialog-username = "";
                                root.account-dialog-advanced = false;
                                root.account-dialog-uuid = "";
                                root.open-account-dialog();
                            }
                        }
                        for server[i] in root.auth-server-names: NavItem {
                            icon-path: Icons.person;
                            title: server;
                            subtitle: "外置登录";
                            clicked => { root.open-authlib-login-dialog(i); }
                        }

                        Rectangle { vertical-stretch: 1; }

                        NavItem {
                            icon-path: Icons.add;
                            title: "添加认证服务器";
                            subtitle: "外置登录";
                            clicked => { root.open-add-auth-server-dialog(); }
                        }
                    }

                    if root.page == 3: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 18px;
                        alignment: start;

                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            NavGroupLabel { text: "新游戏"; }
                            Rectangle { height: 1phx; background: #55597a; }
                            NavItem {
                                icon-path: Icons.stadia-controller;
                                title: "游戏";
                                subtitle: "";
                                selected: root.download-section == 0;
                                clicked => { root.switch-download-section(0); }
                            }
                            NavItem {
                                icon-path: Icons.package2;
                                title: "整合包";
                                subtitle: "";
                                selected: root.download-section == 1;
                                clicked => { root.switch-download-section(1); }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            NavGroupLabel { text: "游戏内容"; }
                            Rectangle { height: 1phx; background: #55597a; }
                            NavItem {
                                icon-path: Icons.extension;
                                title: "模组";
                                subtitle: "";
                                selected: root.download-section == 2;
                                clicked => { root.switch-download-section(2); }
                            }
                            NavItem {
                                icon-path: Icons.texture;
                                title: "资源包";
                                subtitle: "";
                                selected: root.download-section == 3;
                                clicked => { root.switch-download-section(3); }
                            }
                            NavItem {
                                icon-path: Icons.wb-sunny;
                                title: "光影";
                                subtitle: "";
                                selected: root.download-section == 4;
                                clicked => { root.switch-download-section(4); }
                            }
                        }
                    }

                    if root.page == 7: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 6px;

                        NavItem { icon-path: Icons.gamepad; title: "全局游戏设置"; subtitle: ""; selected: root.settings-tab == 0; clicked => { root.switch-settings-tab(0); } }
                        NavItem {
                            icon-path: Icons.rocket-launch;
                            title: "Java 管理";
                            subtitle: "";
                            selected: root.settings-tab == 1;
                            clicked => {
                                root.switch-settings-tab(1);
                                root.refresh-java();
                            }
                        }

                        NavGroupLabel { text: "启动器"; }
                        Rectangle { height: 1phx; background: #55597a; }
                        NavItem { icon-path: Icons.wb-sunny; title: "外观"; subtitle: ""; selected: root.settings-tab == 3; clicked => { root.switch-settings-tab(3); } }
                        NavItem { icon-path: Icons.download; title: "下载"; subtitle: ""; selected: root.settings-tab == 4; clicked => { root.switch-settings-tab(4); } }

                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.page == 6: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 6px;

                        NavItem {
                            icon-path: Icons.settings;
                            title: "游戏设置";
                            subtitle: "";
                            selected: root.instance-tab == 0;
                            clicked => { root.switch-instance-tab(0); }
                        }
                        NavItem {
                            icon-path: Icons.package2;
                            title: "自动安装";
                            subtitle: "";
                            selected: root.instance-tab == 1;
                            clicked => { root.switch-instance-tab(1); }
                        }
                        NavItem {
                            icon-path: Icons.extension;
                            title: "模组管理";
                            subtitle: "";
                            selected: root.instance-tab == 2;
                            clicked => { root.switch-instance-tab(2); }
                        }
                        NavItem {
                            icon-path: Icons.texture;
                            title: "资源包管理";
                            subtitle: "";
                            selected: root.instance-tab == 3;
                            clicked => { root.switch-instance-tab(3); }
                        }
                        NavItem {
                            icon-path: Icons.wb-sunny;
                            title: "光影管理";
                            subtitle: "";
                            selected: root.instance-tab == 4;
                            clicked => { root.switch-instance-tab(4); }
                        }
                        NavItem {
                            icon-path: Icons.public-icon;
                            title: "世界管理";
                            subtitle: "";
                            selected: root.instance-tab == 5;
                            clicked => { root.switch-instance-tab(5); }
                        }

                        Rectangle { vertical-stretch: 1; }

                        NavItem {
                            icon-path: Icons.rocket-launch;
                            title: "测试游戏";
                            subtitle: "";
                            clicked => { root.launch-instance(root.settings-instance-id); }
                        }
                        NavItem {
                            icon-path: Icons.folder-open;
                            title: "浏览";
                            subtitle: "";
                            clicked => { root.open-run-folder(root.settings-instance-id); }
                        }
                        instance-menu-button := NavItem {
                            icon-path: Icons.list;
                            title: "管理";
                            subtitle: "";
                            clicked => {
                                root.instance-menu-page = 0;
                                root.instance-menu-input = root.settings-instance-id;
                                root.instance-menu-export-name = root.settings-instance-id;
                                root.instance-menu-export-version = "1.0";
                                root.instance-menu-export-summary = "";
                                root.instance-menu-x = self.absolute-position.x + self.width;
                                root.instance-menu-y = self.absolute-position.y + self.height;
                                root.reveal-instance-menu();
                            }
                        }
                    }

                    if root.page == 8: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 6px;

                        NavItem {
                            icon-path: Icons.help;
                            title: "世界信息";
                            subtitle: "";
                            selected: root.world-detail-tab == 0;
                            clicked => { root.switch-world-detail-tab(0); }
                        }
                        NavItem {
                            icon-path: Icons.archive;
                            title: "备份管理";
                            subtitle: "";
                            selected: root.world-detail-tab == 1;
                            clicked => { root.switch-world-detail-tab(1); }
                        }
                        if root.world-detail-data-packs: NavItem {
                            icon-path: Icons.extension;
                            title: "数据包管理";
                            subtitle: "";
                            selected: root.world-detail-tab == 2;
                            clicked => { root.switch-world-detail-tab(2); }
                        }

                        Rectangle { vertical-stretch: 1; }

                        if root.world-detail-quick-play: NavItem {
                            icon-path: Icons.rocket-launch;
                            title: "启动";
                            subtitle: "";
                            enabled: !root.world-detail-read-only;
                            clicked => { root.launch-world(root.world-detail-folder); }
                        }
                        NavItem {
                            icon-path: Icons.folder-open;
                            title: "浏览";
                            subtitle: "";
                            clicked => { root.open-world-folder(root.world-detail-folder); }
                        }
                        world-detail-menu-button := NavItem {
                            icon-path: Icons.list;
                            title: "管理";
                            subtitle: "";
                            clicked => {
                                root.world-menu-folder = root.world-detail-folder;
                                root.world-menu-name = root.world-detail-name;
                                root.world-menu-locked = root.world-detail-read-only;
                                root.world-menu-quick-play = root.world-detail-quick-play;
                                root.world-menu-input = root.world-detail-folder;
                                root.world-menu-page = 0;
                                root.world-menu-x = world-detail-menu-button.absolute-position.x + 208px;
                                root.world-menu-y = world-detail-menu-button.absolute-position.y - 262px;
                                root.reveal-world-menu();
                            }
                        }
                    }
                }
            }

            if root.page == 0: Rectangle {
                clip: true;

                if root.show-instance-picker: TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.show-instance-picker = false; }
                }

                Rectangle {
                    x: parent.width - self.width - 24px;
                    property <length> shown-y: parent.height - 48px - 24px - self.height - 6px;
                    y: root.show-instance-picker ? self.shown-y : self.shown-y + 6px;
                    width: min(220px, parent.width - 48px);
                    height: (root.instances.length == 0 ? 1 : min(root.instances.length, 4)) * 48px;
                    opacity: root.show-instance-picker ? 1 : 0;
                    visible: root.show-instance-picker || self.opacity > 0.001;
                    border-radius: 8px;
                    clip: true;
                    background: white;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000055;
                    animate y, opacity {
                        duration: 140ms;
                        easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
                    }
                    states [
                        navigation-out when root.page-transition-phase == 1 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: parent.width - self.width + 6px;
                            in { animate x { duration: 100ms; easing: ease; } }
                        }
                        navigation-in when root.page-transition-phase == 2 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: parent.width - self.width + 6px;
                            out { animate x { duration: 100ms; easing: ease; } }
                        }
                    ]

                    if root.instances.length == 0: Text {
                        text: "未安装任何实例";
                        color: #888;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.instances.length > 0: ListView {
                        for row[i] in root.instances: Rectangle {
                            height: 48px;
                            background: pick-hover.pressed ? #dedff0 : (pick-hover.has-hover ? #f0f0fa : transparent);
                            pick-hover := TouchArea {
                                clicked => {
                                    root.selected-instance-index = i;
                                    root.select-instance(i);
                                    root.show-instance-picker = false;
                                }
                            }
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    InstanceIcon { loader-kind: row.loader-kind; width: 28px; height: 28px; }
                                }
                                Text {
                                    text: row.id;
                                    font-size: 13px;
                                    color: #1a1a1a;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    x: parent.width - self.width - 24px;
                    y: parent.height - self.height - 24px;
                    width: min(220px, parent.width - 48px);
                    height: 48px;
                    border-radius: 8px;
                    clip: true;
                    states [
                        navigation-out when root.page-transition-phase == 1 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: parent.width - self.width + 6px;
                            in { animate x { duration: 100ms; easing: ease; } }
                        }
                        navigation-in when root.page-transition-phase == 2 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: parent.width - self.width + 6px;
                            out { animate x { duration: 100ms; easing: ease; } }
                        }
                    ]
                    background: start-launch.pressed || launch-menu.pressed ? #454ab2
                        : (start-launch.has-hover || launch-menu.has-hover ? #555acb : #6266d8);
                    animate background { duration: 90ms; }

                    start-launch := TouchArea {
                        width: parent.width - 36px;
                        height: 100%;
                        clicked => {
                            if root.selected-instance-id != "" {
                                root.launch-instance(root.selected-instance-id);
                            } else {
                                root.stub-clicked("先选择一个游戏实例");
                            }
                        }
                    }

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: "启动游戏"; color: white; font-size: 15px; font-weight: 700; horizontal-alignment: center; }
                            if root.selected-instance-id != "": Text { text: root.selected-instance-id; color: #ffffffcc; font-size: 10px; horizontal-alignment: center; }
                        }
                        Rectangle { width: 1px; background: #ffffff40; }
                        Rectangle {
                            width: 36px;
                            background: launch-menu.pressed ? #00000020 : (launch-menu.has-hover ? #ffffff16 : transparent);
                            animate background { duration: 90ms; }
                            launch-menu := TouchArea { clicked => { root.show-instance-picker = !root.show-instance-picker; } }
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    IconGlyph { d: Icons.arrow-drop-up; fill: white; width: 18px; height: 18px; }
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 1: Rectangle {
                clip: true;
                background: #eef1f89e;

                VerticalLayout {
                    states [
                        navigation-out when root.page-transition-phase == 1 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: 30px;
                            in { animate x { duration: 100ms; easing: ease; } }
                        }
                        navigation-in when root.page-transition-phase == 2 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: 30px;
                            out { animate x { duration: 100ms; easing: ease; } }
                        }
                    ]
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 12px;
                    padding-bottom: 18px;
                    spacing: 8px;
                    ContentCard {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 8px;
                            IconGlyph { d: Icons.search; fill: #999; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                search-input := ToolbarTextField {
                                    width: 100%;
                                    placeholder: "搜索实例";
                                    text: root.filter-text;
                                    edited(text) => { root.filter-text = text; root.filter-changed(text); }
                                }
                            }
                        }
                    }

                    ContentCard {

                        if root.instances.length == 0: VerticalLayout {
                            alignment: center;
                            Text {
                                text: "没有已安装的游戏。\n点左下角\"安装新游戏\"添加一个。";
                                horizontal-alignment: center;
                                color: #555;
                                font-size: 14px;
                            }
                        }
                        if root.instances.length > 0: ListView {
                            for row[i] in root.instances: Rectangle {
                                height: 60px;
                                background: row-hover.pressed ? #e1e3f2
                                    : (i == root.selected-instance-index ? #eceeff : (row-hover.has-hover ? #f3f4fb : transparent));
                                animate background { duration: 100ms; }
                                row-hover := TouchArea { clicked => { root.selected-instance-index = i; root.select-instance(i); } }
                                HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    padding-left: 16px;
                                    padding-right: 12px;
                                    spacing: 10px;

                                    Rectangle {
                                        width: 16px; height: 16px; border-radius: 8px;
                                        border-width: 2px;
                                        border-color: i == root.selected-instance-index ? #6266d8 : #ccc;
                                        y: (parent.height - self.height) / 2;
                                        if i == root.selected-instance-index: Rectangle {
                                            width: 8px; height: 8px; border-radius: 4px; background: #6266d8;
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        }
                                    }
                                    InstanceIcon { loader-kind: row.loader-kind; width: 32px; height: 32px; y: (parent.height - self.height) / 2; }

                                    if i != root.renaming-index: Text {
                                        horizontal-stretch: 1;
                                        text: row.id;
                                        font-size: 14px;
                                        color: #1a1a1a;
                                        vertical-alignment: center;
                                    }
                                    if i == root.renaming-index: HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            rename-input := ToolbarTextField {
                                                width: 100%;
                                                text: row.id;
                                                accepted(text) => { root.rename-instance(row.id, text); root.renaming-index = -1; }
                                            }
                                        }
                                        SmallIconButton {
                                            icon-path: Icons.check-circle;
                                            icon-color: #2e7d32;
                                            clicked => { root.rename-instance(row.id, rename-input.text); root.renaming-index = -1; }
                                        }
                                    }

                                    SmallIconButton { icon-path: Icons.rocket-launch; icon-color: #6266d8; clicked => { root.launch-instance(row.id); } }
                                    SmallIconButton {
                                        icon-path: Icons.settings;
                                        clicked => {
                                            root.open-instance-settings(row.id);
                                            root.navigate-to(6, 1);
                                        }
                                    }
                                    SmallIconButton { icon-path: Icons.edit; clicked => { root.renaming-index = i; } }
                                    SmallIconButton { icon-path: Icons.content-copy; clicked => { root.duplicate-instance(row.id); } }
                                    SmallIconButton { icon-path: Icons.folder-open; clicked => { root.open-run-folder(row.id); } }
                                    SmallIconButton {
                                        icon-path: Icons.delete-icon;
                                        icon-color: i == root.delete-confirm-index ? #c62828 : #555;
                                        clicked => {
                                            if i == root.delete-confirm-index {
                                                root.delete-instance(row.id);
                                                root.delete-confirm-index = -1;
                                            } else {
                                                root.delete-confirm-index = i;
                                            }
                                        }
                                    }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: #ececf2; }
                            }
                        }
                    }

                }
            }

            if root.page == 2: Rectangle {
                clip: true;
                background: #eef1f89e;

                VerticalLayout {
                    states [
                        navigation-out when root.page-transition-phase == 1 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: 30px;
                            in { animate x { duration: 100ms; easing: ease; } }
                        }
                        navigation-in when root.page-transition-phase == 2 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: 30px;
                            out { animate x { duration: 100ms; easing: ease; } }
                        }
                    ]
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 12px;
                    padding-bottom: 18px;

                    ContentCard {

                        if root.accounts.length == 0: VerticalLayout {
                            alignment: center;
                            Text { text: "没有游戏账户"; color: #77737d; font-size: 13px; horizontal-alignment: center; }
                        }
                        if root.accounts.length > 0: ListView {
                            for name[i] in root.accounts: Rectangle {
                                height: 60px;
                                background: acc-hover.pressed ? #e1e3f2
                                    : (i == root.selected-account-index ? #eceeff : (acc-hover.has-hover ? #f3f4fb : transparent));
                                animate background { duration: 100ms; }
                                acc-hover := TouchArea { clicked => { root.selected-account-index = i; root.select-account(i); } }
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 16px; height: 16px; border-radius: 8px;
                                        border-width: 2px;
                                        border-color: i == root.selected-account-index ? #6266d8 : #ccc;
                                        y: (parent.height - self.height) / 2;
                                        if i == root.selected-account-index: Rectangle {
                                            width: 8px; height: 8px; border-radius: 4px; background: #6266d8;
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        }
                                    }
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 4px; background: #d9d9e8;
                                        clip: true;
                                        y: (parent.height - self.height) / 2;
                                        if i >= root.account-has-avatars.length || !root.account-has-avatars[i]: Image {
                                            source: @image-url("assets/steve.svg");
                                            width: 100%;
                                            height: 100%;
                                            image-fit: cover;
                                        }
                                        if i < root.account-has-avatars.length && root.account-has-avatars[i]: Image {
                                            source: root.account-avatars[i];
                                            source-clip-x: 8;
                                            source-clip-y: 8;
                                            source-clip-width: 8;
                                            source-clip-height: 8;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: fill;
                                            image-rendering: pixelated;
                                        }
                                        if i < root.account-has-avatars.length && root.account-has-avatars[i]: Image {
                                            source: root.account-avatars[i];
                                            source-clip-x: 40;
                                            source-clip-y: 8;
                                            source-clip-width: 8;
                                            source-clip-height: 8;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: fill;
                                            image-rendering: pixelated;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: name; font-size: 14px; color: #1a1a1a; }
                                        Text {
                                            text: i < root.account-kinds.length && root.account-kinds[i] == "microsoft"
                                                ? "微软账户"
                                                : (i < root.account-kinds.length && root.account-kinds[i] == "authlibInjector"
                                                    ? "外置登录账户" : "离线账户");
                                            font-size: 11px;
                                            color: #888;
                                        }
                                    }
                                    SmallIconButton {
                                        icon-path: Icons.content-copy;
                                        icon-color: #555;
                                        clicked => { root.copy-account-uuid(i); }
                                    }
                                    SmallIconButton { icon-path: Icons.delete-icon; icon-color: #555; clicked => { root.remove-account(i); } }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: #ececf2; }
                            }
                        }
                    }
                }
            }

            if root.page == 3: Rectangle {
                clip: true;
                background: #eef1f89e;

                download-content-motion := VerticalLayout {
                    states [
                        navigation-out when root.page-transition-phase == 1 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: 30px;
                            in { animate x { duration: 100ms; easing: ease; } }
                        }
                        navigation-in when root.page-transition-phase == 2 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: 30px;
                            out { animate x { duration: 100ms; easing: ease; } }
                        }
                        section-forward-out when root.download-section-phase == 1 && root.download-section-forward: {
                            x: -50px;
                            opacity: 0;
                            in { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        section-backward-out when root.download-section-phase == 1 && !root.download-section-forward: {
                            x: 50px;
                            opacity: 0;
                            in { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        section-forward-in when root.download-section-phase == 2 && root.download-section-forward: {
                            x: 50px;
                            opacity: 0;
                            out { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        section-backward-in when root.download-section-phase == 2 && !root.download-section-forward: {
                            x: -50px;
                            opacity: 0;
                            out { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                    ]
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 12px;
                    padding-bottom: 18px;
                    spacing: 8px;

                    if root.download-tab == 0: VerticalLayout {
                    spacing: 8px;
                    ContentCard {
                        height: 46px;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: 12px;
                            padding-right: 8px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Text { text: "名称"; font-size: 12px; color: #555; }
                            }
                            name-search := ToolbarTextField {
                                horizontal-stretch: 1;
                                placeholder: "输入版本名称进行搜索";
                                text: root.remote-filter-name;
                                edited(text) => { root.remote-filter-name = text; root.remote-filter-changed(); }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text { text: "版本类型"; font-size: 12px; color: #555; }
                            }
                            DownloadChoiceField {
                                horizontal-stretch: 0;
                                options: root.remote-type-labels;
                                selected-index <=> root.remote-type-index;
                                changed => { root.remote-filter-changed(); }
                            }

                            Rectangle {
                                width: 52px;
                                border-radius: 4px;
                                background: refresh-hover.pressed ? #454ab2 : (refresh-hover.has-hover ? #565bd0 : #6266d8);
                                animate background { duration: 100ms; }
                                refresh-hover := TouchArea { clicked => { root.refresh-remote-versions(); } }
                                Text { text: "刷新"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                            }
                        }
                    }

                    ContentCard {

                        if root.remote-loading: VerticalLayout {
                            alignment: center;
                            Text {
                                text: "正在获取版本清单…";
                                horizontal-alignment: center;
                                color: #888;
                                font-size: 13px;
                                opacity: root.loading-pulse ? 0.45 : 1;
                                animate opacity { duration: 550ms; easing: ease-in-out; }
                            }
                        }
                        if !root.remote-loading && root.remote-versions.length == 0: VerticalLayout {
                            alignment: center;
                            Text { text: "没有匹配的版本。\n换一个筛选条件, 或者点右上角\"刷新\"。"; horizontal-alignment: center; color: #888; font-size: 13px; }
                        }
                        if !root.remote-loading && root.remote-versions.length > 0: ListView {
                            for row[i] in root.remote-versions: Rectangle {
                                height: 56px;
                                background: ver-hover.pressed ? #e8eaf5 : (ver-hover.has-hover ? #f5f6fc : transparent);
                                animate background { duration: 100ms; }
                                ver-hover := TouchArea {
                                    clicked => {
                                        root.install-game-version = row.id;
                                        root.install-instance-name = row.id;
                                        root.selected-loader-kind = 0;
                                        root.selected-loader-version = "";
                                        root.navigate-to(4, 1);
                                    }
                                }

                                HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    spacing: 10px;

                                    VerticalLayout {
                                        alignment: center;
                                        Image { source: @image-url("assets/grass.png"); width: 28px; height: 28px; }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 3px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: row.id; font-size: 14px; font-weight: 700; color: #1a1a1a; }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                ProjectTag { text: row.type-label; }
                                            }
                                        }
                                        Text { text: row.date; font-size: 11px; color: #8a8a92; }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        SmallIconButton {
                                            icon-path: Icons.web-globe;
                                            clicked => { root.open-game-version-wiki(row.id); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        SmallIconButton {
                                            icon-path: Icons.arrow-forward;
                                            clicked => {
                                                root.install-game-version = row.id;
                                                root.install-instance-name = row.id;
                                                root.selected-loader-kind = 0;
                                                root.selected-loader-version = "";
                                                root.navigate-to(4, 1);
                                            }
                                        }
                                    }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: #f0f0f4; }
                            }
                        }
                    }

                    }

                if root.download-tab == 1: VerticalLayout {
                    spacing: 8px;

                    if !root.mod-detail-open: VerticalLayout {
                        spacing: 8px;
                        ContentCard {
                            height: 91px;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 7px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    if root.mod-search-kind != 3: HorizontalLayout {
                                        horizontal-stretch: 2;
                                        spacing: 5px;
                                        Text { text: "游戏"; width: 28px; font-size: 12px; color: #333; vertical-alignment: center; }
                                        DownloadInstanceField {
                                            horizontal-stretch: 1;
                                            instances: root.instances;
                                            selected-index <=> root.selected-instance-index;
                                        }
                                    }
                                    HorizontalLayout {
                                        horizontal-stretch: 5;
                                        spacing: 5px;
                                        Text { text: "名称"; width: 28px; font-size: 12px; color: #333; vertical-alignment: center; }
                                        mod-search-input := ToolbarTextField {
                                            horizontal-stretch: 1;
                                            placeholder: "支持中英文搜索";
                                            text: root.mod-search-query;
                                            edited(text) => { root.mod-search-query = text; }
                                            accepted => { root.search-mods(); }
                                        }
                                    }
                                    if root.mod-search-kind == 3: Rectangle {
                                        width: 86px;
                                        border-radius: 4px;
                                        background: install-pack-entry-hover.pressed ? #454ab2 : (install-pack-entry-hover.has-hover ? #565bd0 : #6266d8);
                                        animate background { duration: 100ms; }
                                        install-pack-entry-hover := TouchArea {
                                            clicked => {
                                                root.download-tab = 2;
                                                root.modpack-source = 0;
                                            }
                                        }
                                        Text { text: "本地导入"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 5px;
                                        Text { text: "游戏版本"; width: 52px; font-size: 12px; color: #333; vertical-alignment: center; }
                                        DownloadChoiceField {
                                            horizontal-stretch: 1;
                                            options: root.mod-game-version-options;
                                            selected-index <=> root.mod-game-version-index;
                                        }
                                    }
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 5px;
                                        Text { text: "类别"; width: 28px; font-size: 12px; color: #333; vertical-alignment: center; }
                                        DownloadChoiceField {
                                            horizontal-stretch: 1;
                                            options: root.mod-category-options;
                                            selected-index <=> root.mod-category-index;
                                        }
                                    }
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 5px;
                                        Text { text: "排序"; width: 28px; font-size: 12px; color: #333; vertical-alignment: center; }
                                        DownloadChoiceField {
                                            horizontal-stretch: 1;
                                            options: root.mod-sort-options;
                                            selected-index <=> root.mod-sort-index;
                                        }
                                    }
                                    Rectangle {
                                        width: 52px;
                                        border-radius: 4px;
                                        background: mod-search-hover.pressed ? #454ab2 : (mod-search-hover.has-hover ? #565bd0 : #6266d8);
                                        animate background { duration: 100ms; }
                                        mod-search-hover := TouchArea { clicked => { root.search-mods(); } }
                                        Text { text: "搜索"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                    }
                                }
                            }
                        }

                        ContentCard {

                            if root.mod-search-loading && root.mod-search-results.length == 0: VerticalLayout {
                                alignment: center;
                                Text { text: "正在搜索…"; horizontal-alignment: center; color: #888; font-size: 13px; }
                            }
                            if !root.mod-search-loading && root.mod-search-results.length == 0: VerticalLayout {
                                alignment: center;
                                Text { text: "没有匹配的" + root.mod-search-kind-label + "。"; horizontal-alignment: center; color: #888; font-size: 13px; }
                            }
                            if root.mod-search-results.length > 0: mod-result-list := ListView {
                                viewport-y <=> root.mod-search-scroll-y;
                                scrolled => {
                                    if root.mod-search-has-more && !root.mod-search-loading
                                        && -self.viewport-y + self.visible-height >= self.viewport-height - 116px {
                                        root.load-more-mods();
                                    }
                                }
                                for row in root.mod-search-results: Rectangle {
                                    height: 58px;
                                    background: mod-row-hover.pressed ? #e4e5ef : (mod-row-hover.has-hover ? #f0f0f6 : transparent);
                                    animate background { duration: 100ms; }
                                    mod-row-hover := TouchArea { clicked => { root.open-mod-project(row.project-id); } }
                                    HorizontalLayout {
                                        width: 100%;
                                        height: 100%;
                                        padding-left: 8px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            width: 40px;
                                            alignment: center;
                                            Rectangle {
                                                width: 38px;
                                                height: 38px;
                                                border-radius: 4px;
                                                background: #dce2fb;
                                                clip: true;
                                                Image { source: row.icon; width: 100%; height: 100%; image-fit: cover; }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text { text: row.title; font-size: 14px; font-weight: 700; color: #1a1a1a; }
                                                VerticalLayout {
                                                    alignment: center;
                                                    ProjectTag { text: row.categories; }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            Text { text: row.description; font-size: 11px; color: #55535d; overflow: elide; }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; background: #d8d7df; }
                                }
                            }
                            if root.mod-search-loading && root.mod-search-results.length > 0: Rectangle {
                                x: (parent.width - 104px) / 2;
                                y: parent.height - 32px;
                                width: 104px;
                                height: 24px;
                                border-radius: 12px;
                                background: #ffffffee;
                                Text { text: "正在加载更多…"; color: #66636e; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    if root.mod-detail-open: VerticalLayout {
                        spacing: 8px;
                        ContentCard {
                            height: 64px;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 10px;
                                Rectangle {
                                    width: 46px;
                                    height: 46px;
                                    border-radius: 4px;
                                    clip: true;
                                    background: #dce2fb;
                                    Image { source: root.mod-detail-icon; width: 100%; height: 100%; image-fit: cover; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: root.mod-detail-title; font-size: 15px; font-weight: 700; color: #1b1a20; }
                                        VerticalLayout {
                                            alignment: center;
                                            ProjectTag { text: root.mod-detail-categories; }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    Text { text: root.mod-detail-description; font-size: 11px; color: #55535d; overflow: elide; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    SmallIconButton {
                                        icon-path: Icons.web-globe;
                                        clicked => {
                                            root.open-url(
                                                "https://modrinth.com/project/" + root.mod-detail-project-id
                                            );
                                        }
                                    }
                                }
                            }
                        }
                        ContentCard {
                            if root.mod-detail-loading: VerticalLayout {
                                alignment: center;
                                Text { text: "正在获取可用版本…"; color: #77747f; font-size: 13px; horizontal-alignment: center; }
                            }
                            if !root.mod-detail-loading: ListView {
                                for version in root.mod-detail-versions: Rectangle {
                                    height: version.header ? 40px : (version.expanded ? 58px : 0px);
                                    opacity: version.header || version.expanded ? 1 : 0;
                                    clip: true;
                                    animate height, opacity { duration: 150ms; easing: ease-in-out; }
                                    background: version-row-hover.pressed ? #e3e4ed
                                        : (version-row-hover.has-hover ? #f0f0f5 : transparent);
                                    version-row-hover := TouchArea {
                                        enabled: version.header || version.expanded;
                                        clicked => {
                                            if version.header {
                                                root.toggle-mod-version-group(version.game-version);
                                            } else {
                                                root.selected-mod-version-id = version.version-id;
                                                root.selected-mod-file-name = version.file-name;
                                                root.selected-mod-version-title = version.title;
                                                root.selected-mod-version-detail = version.channel + (version.loaders == "" ? "" : " · " + version.loaders);
                                                if root.mod-search-kind == 3 {
                                                    root.modpack-import-instance-name = root.suggest-instance-name(root.mod-detail-title);
                                                    root.modpack-instance-name-conflict =
                                                        root.instance-name-exists(root.modpack-import-instance-name);
                                                }
                                                root.show-mod-version-dialog = true;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: version.header ? 14px : 24px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        if version.header: Text {
                                            text: "Minecraft " + version.game-version;
                                            font-size: 13px;
                                            color: #25232b;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        if version.header: IconGlyph {
                                            d: version.expanded ? Icons.arrow-drop-up : Icons.arrow-drop-down;
                                            fill: #55535d;
                                            width: 16px;
                                            height: 10px;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        if !version.header: Rectangle {
                                            width: 20px;
                                            VersionChannelIcon {
                                                release: version.channel == "正式版";
                                                x: -7px;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }
                                        if !version.header: VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    text: version.title;
                                                    font-size: 13px;
                                                    color: #222028;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                                ProjectTag { text: version.channel; }
                                                if version.loaders != "": ProjectTag { text: version.loaders; }
                                            }
                                            Text { text: version.date; font-size: 10px; color: #66636d; }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; background: #d8d7df; }
                                }
                            }
                        }
                    }
                }

                if root.download-tab == 2: VerticalLayout {
                    spacing: 8px;

                    ContentCard {
                        height: 48px;
                        HorizontalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Rectangle {
                                width: 90px;
                                border-radius: 4px;
                                background: root.modpack-source == 0 ? #6266d8 : transparent;
                                modpack-source-0-hover := TouchArea { clicked => { root.modpack-source = 0; } }
                                Text { text: "本地文件"; font-size: 12px; color: root.modpack-source == 0 ? white : #555; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                            }
                            Rectangle {
                                width: 90px;
                                border-radius: 4px;
                                background: root.modpack-source == 1 ? #6266d8 : transparent;
                                modpack-source-1-hover := TouchArea { clicked => { root.modpack-source = 1; } }
                                Text { text: "链接下载"; font-size: 12px; color: root.modpack-source == 1 ? white : #555; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                            }
                        }
                    }

                    if root.modpack-source == 0: ContentCard {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            alignment: start;
                            Text { text: "导入本地整合包文件 (.mrpack)"; font-size: 14px; font-weight: 700; color: #333; }
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                Text { text: "整合包文件路径"; font-size: 12px; color: #555; }
                                MaterialDialogField { placeholder: "C:/path/to/pack.mrpack"; text <=> root.modpack-import-path; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                Text { text: "新实例名"; font-size: 12px; color: #555; }
                                MaterialDialogField { placeholder: "例如 all-the-mods-9"; text <=> root.modpack-import-instance-name; }
                            }
                            Rectangle {
                                height: 34px;
                                width: 100px;
                                border-radius: 4px;
                                background: modpack-import-file-hover.pressed ? #454ab2 : (modpack-import-file-hover.has-hover ? #565bd0 : #6266d8);
                                animate background { duration: 100ms; }
                                modpack-import-file-hover := TouchArea { clicked => { if !root.modpack-import-loading { root.import-modpack-from-file(); } } }
                                Text { text: root.modpack-import-loading ? "正在导入…" : "导入"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                            }
                        }
                    }

                    if root.modpack-source == 1: ContentCard {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            alignment: start;
                            Text { text: "从互联网直链下载整合包 (.mrpack)"; font-size: 14px; font-weight: 700; color: #333; }
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                Text { text: "下载链接"; font-size: 12px; color: #555; }
                                MaterialDialogField { placeholder: "https://example.com/pack.mrpack"; text <=> root.modpack-download-url; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                Text { text: "新实例名"; font-size: 12px; color: #555; }
                                MaterialDialogField { placeholder: "例如 all-the-mods-9"; text <=> root.modpack-import-instance-name; }
                            }
                            Rectangle {
                                height: 34px;
                                width: 100px;
                                border-radius: 4px;
                                background: modpack-import-url-hover.pressed ? #454ab2 : (modpack-import-url-hover.has-hover ? #565bd0 : #6266d8);
                                animate background { duration: 100ms; }
                                modpack-import-url-hover := TouchArea { clicked => { if !root.modpack-import-loading { root.import-modpack-from-url(); } } }
                                Text { text: root.modpack-import-loading ? "正在下载…" : "下载并导入"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                            }
                        }
                    }

                }
                }

            }

            if root.page == 4: Rectangle {
                width: parent.width;
                clip: true;
                Image { source: @image-url("assets/wallpaper.jpg"); width: parent.width; height: parent.height; image-fit: cover; }

                VerticalLayout {
                    states [
                        navigation-out when root.page-transition-phase == 1 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: 30px;
                            in { animate x { duration: 100ms; easing: ease; } }
                        }
                        navigation-in when root.page-transition-phase == 2 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: 30px;
                            out { animate x { duration: 100ms; easing: ease; } }
                        }
                    ]
                    padding: 16px;
                    spacing: 12px;

                    Rectangle {
                        height: 52px;
                        background: white;
                        border-radius: 5px;
                        drop-shadow-blur: 7px;
                        drop-shadow-color: #00000033;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            Text { text: "游戏实例名称"; font-size: 13px; color: #303038; vertical-alignment: center; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                ToolbarTextField {
                                    width: 100%;
                                    text: root.install-instance-name;
                                    edited(text) => { root.install-instance-name = text; }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        vertical-stretch: 0;
                        height: 264px;
                        spacing: 12px;
                        first-loader-row := HorizontalLayout {
                            width: 100%;
                            height: 126px;
                            spacing: 10px;
                            InstallerCard {
                                width: (first-loader-row.width - 30px) / 4;
                                icon: @image-url("assets/grass.png");
                                name: "Minecraft";
                                version: root.install-game-version;
                                show-arrow: false;
                                selected: true;
                            }
                            InstallerCard {
                                width: (first-loader-row.width - 30px) / 4;
                                icon: @image-url("assets/forge.png");
                                name: "Forge";
                                version: root.selected-loader-kind == 1 ? root.selected-loader-version : "不安装";
                                selected: root.selected-loader-kind == 1;
                                clicked => {
                                    root.loader-picker-instance-mode = false;
                                    root.loader-picker-kind = 1;
                                    root.loader-filter-text = "";
                                    root.navigate-to(5, 1);
                                    root.request-loader-versions(1, root.install-game-version);
                                }
                            }
                            InstallerCard {
                                width: (first-loader-row.width - 30px) / 4;
                                icon: @image-url("assets/neoforge.png");
                                name: "NeoForge";
                                version: root.selected-loader-kind == 2 ? root.selected-loader-version : "不安装";
                                selected: root.selected-loader-kind == 2;
                                clicked => {
                                    root.loader-picker-instance-mode = false;
                                    root.loader-picker-kind = 2;
                                    root.loader-filter-text = "";
                                    root.navigate-to(5, 1);
                                    root.request-loader-versions(2, root.install-game-version);
                                }
                            }
                            InstallerCard {
                                width: (first-loader-row.width - 30px) / 4;
                                icon: @image-url("assets/optifine.png");
                                name: "OptiFine";
                                version: root.selected-loader-kind == 3 ? root.selected-loader-version : "不安装";
                                selected: root.selected-loader-kind == 3;
                                clicked => {
                                    root.loader-picker-instance-mode = false;
                                    root.loader-picker-kind = 3;
                                    root.loader-filter-text = "";
                                    root.navigate-to(5, 1);
                                    root.request-loader-versions(3, root.install-game-version);
                                }
                            }
                        }
                        second-loader-row := HorizontalLayout {
                            width: 100%;
                            height: 126px;
                            spacing: 10px;
                            InstallerCard {
                                width: (second-loader-row.width - 30px) / 4;
                                icon: @image-url("assets/fabric.png");
                                name: "Fabric";
                                version: root.selected-loader-kind == 4 ? root.selected-loader-version : "不安装";
                                selected: root.selected-loader-kind == 4;
                                clicked => {
                                    root.loader-picker-instance-mode = false;
                                    root.loader-picker-kind = 4;
                                    root.loader-filter-text = "";
                                    root.navigate-to(5, 1);
                                    root.request-loader-versions(4, root.install-game-version);
                                }
                            }
                            InstallerCard {
                                width: (second-loader-row.width - 30px) / 4;
                                icon: @image-url("assets/fabric.png");
                                name: "Fabric API";
                                version: "暂未支持";
                                enabled: false;
                            }
                            InstallerCard {
                                width: (second-loader-row.width - 30px) / 4;
                                icon: @image-url("assets/quilt.png");
                                name: "Quilt";
                                version: root.selected-loader-kind == 5 ? root.selected-loader-version : "不安装";
                                selected: root.selected-loader-kind == 5;
                                clicked => {
                                    root.loader-picker-instance-mode = false;
                                    root.loader-picker-kind = 5;
                                    root.loader-filter-text = "";
                                    root.navigate-to(5, 1);
                                    root.request-loader-versions(5, root.install-game-version);
                                }
                            }
                            InstallerCard {
                                width: (second-loader-row.width - 30px) / 4;
                                icon: @image-url("assets/quilt.png");
                                name: "QSL/QFAPI";
                                version: "暂未支持";
                                enabled: false;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        height: 42px;
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 100px;
                            border-radius: 5px;
                            background: root.install-instance-name == "" ? #aaa
                                : (install-hover.pressed ? #454ab2 : (install-hover.has-hover ? #565bd0 : #6266d8));
                            animate background { duration: 90ms; }
                            install-hover := TouchArea {
                                enabled: root.install-instance-name != "";
                                clicked => {
                                    root.start-install(
                                        root.install-game-version,
                                        root.install-instance-name,
                                        root.selected-loader-kind,
                                        root.selected-loader-version
                                    );
                                }
                            }
                            Text { text: "安装"; color: white; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }

            if root.page == 5: Rectangle {
                width: parent.width;
                clip: true;
                Image { source: @image-url("assets/wallpaper.jpg"); width: parent.width; height: parent.height; image-fit: cover; }

                VerticalLayout {
                    states [
                        navigation-out when root.page-transition-phase == 1 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: 30px;
                            in { animate x { duration: 100ms; easing: ease; } }
                        }
                        navigation-in when root.page-transition-phase == 2 && (root.page-transition-kind == 0 || root.page-transition-kind == 3): {
                            x: 30px;
                            out { animate x { duration: 100ms; easing: ease; } }
                        }
                    ]
                    padding: 10px;
                    spacing: 8px;

                    Rectangle {
                        height: 48px;
                        background: white;
                        border-radius: 5px;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #00000030;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            Text { text: "名称"; font-size: 12px; color: #333; vertical-alignment: center; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                ToolbarTextField {
                                    width: 100%;
                                    placeholder: "输入版本名称进行搜索";
                                    text: root.loader-filter-text;
                                    edited(text) => {
                                        root.loader-filter-text = text;
                                        root.loader-filter-changed();
                                    }
                                }
                            }
                            Rectangle {
                                width: 52px;
                                border-radius: 4px;
                                background: loader-refresh-hover.pressed ? #454ab2
                                    : (loader-refresh-hover.has-hover ? #565bd0 : #6266d8);
                                animate background { duration: 90ms; }
                                loader-refresh-hover := TouchArea {
                                    clicked => {
                                        root.request-loader-versions(root.loader-picker-kind, root.install-game-version);
                                    }
                                }
                                Text { text: "刷新"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    Rectangle {
                        background: white;
                        border-radius: 5px;
                        clip: true;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #00000030;

                        if root.loader-versions-loading: VerticalLayout {
                            alignment: center;
                            Text {
                                text: "正在获取兼容构建…";
                                color: #777;
                                horizontal-alignment: center;
                                opacity: root.loading-pulse ? 0.45 : 1;
                                animate opacity { duration: 550ms; easing: ease-in-out; }
                            }
                        }
                        if !root.loader-versions-loading && root.loader-version-options.length == 0: VerticalLayout {
                            alignment: center;
                            Text { text: "这个游戏版本没有匹配的可用构建。"; color: #777; horizontal-alignment: center; }
                        }
                        if !root.loader-versions-loading && root.loader-version-options.length > 0: ListView {
                            for version in root.loader-version-options: Rectangle {
                                height: 58px;
                                background: loader-hover.pressed ? #dedff0 : (loader-hover.has-hover ? #f0f1fa : transparent);
                                animate background { duration: 90ms; }
                                loader-hover := TouchArea {
                                    clicked => {
                                        if root.loader-picker-instance-mode {
                                            root.navigate-to(6, 2);
                                            root.install-instance-loader(root.loader-picker-kind, version);
                                        } else {
                                            root.selected-loader-kind = root.loader-picker-kind;
                                            root.selected-loader-version = version;
                                            root.install-instance-name = root.install-game-version + "-" + root.loader-slugs[root.loader-picker-kind];
                                            root.navigate-to(4, 2);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 12px;
                                    spacing: 14px;
                                    Image { source: root.loader-picker-icon; width: 32px; height: 32px; image-fit: contain; y: (parent.height - self.height) / 2; }
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: version; color: #252530; font-size: 14px; font-weight: 600; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                background: #dfe3ff;
                                                border-radius: 3px;
                                                HorizontalLayout {
                                                    padding-left: 5px;
                                                    padding-right: 5px;
                                                    padding-top: 2px;
                                                    padding-bottom: 2px;
                                                    Text { text: root.install-game-version; color: #5b61a5; font-size: 10px; }
                                                }
                                            }
                                        }
                                    }
                                    IconGlyph { d: Icons.arrow-forward; fill: #333; width: 18px; height: 18px; y: (parent.height - self.height) / 2; }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: #d9d9e1; }
                            }
                        }
                    }
                }
            }

            if root.page == 7: Rectangle {
                clip: true;
                background: #eef1f89e;

                settings-content-motion := Rectangle {
                    width: 100%;
                    height: 100%;
                    states [
                        forward-out when root.settings-tab-phase == 1 && root.settings-tab-forward: {
                            x: -50px;
                            opacity: 0;
                            in { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        backward-out when root.settings-tab-phase == 1 && !root.settings-tab-forward: {
                            x: 50px;
                            opacity: 0;
                            in { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        forward-in when root.settings-tab-phase == 2 && root.settings-tab-forward: {
                            x: 50px;
                            opacity: 0;
                            out { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        backward-in when root.settings-tab-phase == 2 && !root.settings-tab-forward: {
                            x: -50px;
                            opacity: 0;
                            out { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                    ]

                    if root.settings-tab == 0: Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-height: global-settings-content.preferred-height;
                        global-settings-content := VerticalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 12px;
                            padding-bottom: 18px;
                            spacing: 8px;

                            SettingsCardTitle { text: "基础设置"; }
                            SettingsGroup {
                                LauncherChoiceLine {
                                    width: 100%;
                                    label: "默认版本隔离策略";
                                    sublabel: "安装新实例时决定是否使用独立游戏目录";
                                    options: ["从不隔离", "仅隔离非原版", "始终隔离"];
                                    option-descriptions: [
                                        "所有实例共用游戏目录",
                                        "仅带模组加载器的实例使用独立目录",
                                        "每个实例均使用独立目录",
                                    ];
                                    selected-index <=> root.global-isolation-index;
                                }
                            }

                            SettingsCardTitle { text: "游戏设置"; }
                            SettingsGroup {
                                VerticalLayout {
                                    SettingsSublist {
                                        title: "游戏 Java";
                                        subtitle: "为不同游戏版本自动选择合适的 Java";
                                        description: ["自动选择", "Java 8", "Java 17", "Java 21", "自定义"][root.global-java-index];
                                        content-height: 220px + (root.global-java-index == 4 ? 48px : 0px);
                                        expanded <=> root.global-java-expanded;
                                        VerticalLayout {
                                            global-java-choice := SettingsRadioList {
                                                options: ["自动选择合适的 Java", "Java 8", "Java 17", "Java 21", "自定义 Java 路径"];
                                                selected-index: root.global-java-index;
                                                edited => { root.global-java-index = self.selected-index; }
                                            }
                                            if root.global-java-index == 4: LauncherTextLine {
                                                label: "Java 可执行文件";
                                                value <=> root.global-custom-java-path;
                                                placeholder: "C:/path/to/java.exe";
                                            }
                                        }
                                    }
                                    SettingsSublist {
                                        title: "内存";
                                        description: root.global-auto-memory ? "自动分配" : root.global-max-memory + " MiB";
                                        content-height: 88px + (root.global-auto-memory ? 0px : 48px);
                                        expanded <=> root.global-memory-expanded;
                                        VerticalLayout {
                                            global-memory-choice := SettingsRadioList {
                                                options: ["自动分配", "手动分配"];
                                                selected-index: root.global-auto-memory ? 0 : 1;
                                                edited => { root.global-auto-memory = self.selected-index == 0; }
                                            }
                                            if !root.global-auto-memory: LauncherTextLine {
                                                label: "最大内存 (MiB)";
                                                value <=> root.global-max-memory;
                                                placeholder: "2048";
                                            }
                                        }
                                    }
                                    SettingsSublist {
                                        title: "游戏窗口";
                                        description: root.global-window-type-index == 1 ? "全屏"
                                            : root.global-window-width + " × " + root.global-window-height;
                                        content-height: 88px + (root.global-window-type-index == 0 ? 96px : 0px);
                                        expanded <=> root.global-window-expanded;
                                        VerticalLayout {
                                            global-window-choice := SettingsRadioList {
                                                options: ["窗口化", "全屏"];
                                                selected-index: root.global-window-type-index;
                                                edited => { root.global-window-type-index = self.selected-index; }
                                            }
                                            if root.global-window-type-index == 0: LauncherTextLine { label: "窗口宽度"; value <=> root.global-window-width; placeholder: "1280"; }
                                            if root.global-window-type-index == 0: LauncherTextLine { label: "窗口高度"; value <=> root.global-window-height; placeholder: "720"; }
                                        }
                                    }
                                    SettingsSublist {
                                        title: "Quick Play";
                                        subtitle: "启动后直接进入服务器、存档或 Realms";
                                        description: ["无", "多人游戏", "单人游戏", "Realms"][root.global-quick-play-index];
                                        content-height: 176px + (root.global-quick-play-index == 0 ? 0px : 48px);
                                        expanded <=> root.global-quickplay-expanded;
                                        VerticalLayout {
                                            global-quick-choice := SettingsRadioList {
                                                options: ["不使用", "多人游戏", "单人游戏", "Realms"];
                                                selected-index: root.global-quick-play-index;
                                                edited => { root.global-quick-play-index = self.selected-index; }
                                            }
                                            if root.global-quick-play-index == 1: LauncherTextLine { label: "服务器地址"; value <=> root.global-quick-play-multiplayer; placeholder: "host:port"; }
                                            if root.global-quick-play-index == 2: LauncherTextLine { label: "存档文件夹名称"; value <=> root.global-quick-play-singleplayer; }
                                            if root.global-quick-play-index == 3: LauncherTextLine { label: "Realm ID"; value <=> root.global-quick-play-realms; }
                                        }
                                    }
                                    SettingsSublist {
                                        title: "高级启动选项";
                                        subtitle: "游戏参数、环境变量与进程优先级";
                                        content-height: 160px;
                                        expanded <=> root.global-advanced-expanded;
                                        VerticalLayout {
                                            LauncherTextLine { label: "游戏参数"; value <=> root.global-game-arguments; placeholder: "--example"; }
                                            LauncherTextLine { label: "环境变量"; sublabel: "一行一个 KEY=VALUE"; value <=> root.global-environment-variables; }
                                            LauncherChoiceLine {
                                                label: "进程优先级";
                                                options: ["低", "较低", "中", "较高", "高"];
                                                selected-index <=> root.global-process-priority-index;
                                            }
                                        }
                                    }
                                }
                            }

                            SettingsCardTitle { text: "启动器"; }
                            SettingsGroup {
                                VerticalLayout {
                                    LauncherChoiceLine {
                                        width: 100%;
                                        label: "启动器可见性";
                                        options: ["关闭启动器", "隐藏启动器", "保持启动器", "退出后重新显示"];
                                        selected-index <=> root.global-launcher-visibility-index;
                                    }
                                    LauncherToggleLine { label: "输出调试信息"; value <=> root.global-debug-log; }
                                }
                            }

                            SettingsCardTitle { text: "JVM 高级设置"; }
                            SettingsGroup {
                                VerticalLayout {
                                    LauncherToggleLine { label: "不生成默认 JVM 参数"; value <=> root.global-no-jvm-options; }
                                    LauncherToggleLine {
                                        label: "不生成优化用 JVM 参数";
                                        value <=> root.global-no-optimizing-jvm-options;
                                        enabled: !root.global-no-jvm-options;
                                        opacity: root.global-no-jvm-options ? 0.45 : 1;
                                    }
                                    LauncherTextLine { label: "JVM 参数"; value <=> root.global-jvm-options; placeholder: "-Dexample=value"; }
                                    SettingsSublist {
                                        title: "已弃用的 JVM 内存设置";
                                        subtitle: "仅用于兼容旧版配置";
                                        content-height: 96px;
                                        expanded <=> root.global-deprecated-memory-expanded;
                                        VerticalLayout {
                                            LauncherTextLine { label: "最小内存 (MiB)"; value <=> root.global-min-memory; }
                                            LauncherTextLine { label: "Metaspace (MiB)"; value <=> root.global-perm-size; }
                                        }
                                    }
                                }
                            }

                            SettingsCardTitle { text: "自定义命令"; }
                            SettingsGroup {
                                VerticalLayout {
                                    LauncherTextLine { label: "启动前执行"; value <=> root.global-pre-launch-command; }
                                    LauncherTextLine { label: "命令包装器"; value <=> root.global-command-wrapper; placeholder: "例如 optirun"; }
                                    LauncherTextLine { label: "退出后执行"; value <=> root.global-post-exit-command; }
                                }
                            }

                            SettingsCardTitle { text: "图形设置"; }
                            SettingsGroup {
                                LauncherChoiceLine {
                                    label: "图形 API";
                                    sublabel: "仅对 Minecraft 26.2 及更高版本生效";
                                    options: ["默认", "OpenGL", "Vulkan"];
                                    selected-index <=> root.global-graphics-backend-index;
                                }
                            }

                            SettingsCardTitle { text: "本地库"; }
                            SettingsGroup {
                                VerticalLayout {
                                    LauncherToggleLine { label: "使用自定义 Natives"; value <=> root.global-use-custom-natives; }
                                    LauncherTextLine {
                                        label: "Natives 目录";
                                        value <=> root.global-natives-directory;
                                        enabled: root.global-use-custom-natives;
                                        opacity: root.global-use-custom-natives ? 1 : 0.45;
                                    }
                                }
                            }
                        }
                    }

                    if root.settings-tab == 1: Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-height: 150px + max(root.java-runtimes.length, 1) * 70px;
                        VerticalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 14px;
                            spacing: 10px;
                            ContentCard {
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    SettingsToolbarButton {
                                        horizontal-stretch: 1;
                                        icon-path: Icons.refresh;
                                        label: "刷新";
                                        clicked => { root.refresh-java(); }
                                    }
                                    JavaDownloadButton {
                                        horizontal-stretch: 1;
                                        enabled: !root.java-download-loading;
                                        selected(index) => { root.download-java(index); }
                                    }
                                }
                            }
                            SettingsCardTitle { text: "已安装的 Java"; }
                            ContentCard {
                                height: max(root.java-runtimes.length, 1) * 70px;
                                if root.java-runtimes.length == 0: Text {
                                    text: "未检测到可用的 Java";
                                    color: #77737d;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    width: 100%;
                                    height: 100%;
                                    for java in root.java-runtimes: Rectangle {
                                        height: 70px;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 10px;
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: center;
                                                IconGlyph { d: Icons.rocket-launch; fill: #565fbc; width: 30px; height: 30px; }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text { text: java.version; color: #282632; font-size: 14px; font-weight: 600; }
                                                Text { text: java.detail; color: #65626d; font-size: 10px; overflow: elide; }
                                                Text { text: java.path; color: #65626d; font-size: 10px; overflow: elide; }
                                            }
                                            SmallIconButton { icon-path: Icons.folder-open; clicked => { root.open-java-folder(java.path); } }
                                        }
                                        Rectangle { y: parent.height - 1px; height: 1px; background: #d8d7df; }
                                    }
                                }
                            }
                            Text {
                                text: "启动器会根据游戏版本自动选择兼容的 Java。";
                                color: #696672;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if root.settings-tab == 3: Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-height: 180px;
                        VerticalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 12px;
                            padding-bottom: 18px;
                            spacing: 8px;

                            SettingsCardTitle { text: "界面"; }
                            SettingsGroup {
                                VerticalLayout {
                                    LauncherToggleLine { label: "标题栏透明"; value <=> root.titlebar-transparent; }
                                    LauncherToggleLine { label: "禁用界面动画"; value <=> root.animation-disabled; }
                                }
                            }
                        }
                    }

                    if root.settings-tab == 4: Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-height: 300px;
                        VerticalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 12px;
                            padding-bottom: 18px;
                            spacing: 8px;

                            SettingsCardTitle { text: "下载源"; }
                            SettingsGroup {
                                VerticalLayout {
                                    LauncherChoiceLine {
                                        label: "版本列表";
                                        options: ["自动选择", "官方源", "镜像源"];
                                        selected-index <=> root.version-source-index;
                                    }
                                    LauncherChoiceLine {
                                        label: "游戏文件";
                                        options: ["自动选择", "官方源", "镜像源"];
                                        selected-index <=> root.file-source-index;
                                    }
                                }
                            }

                            SettingsCardTitle { text: "下载线程"; }
                            SettingsGroup {
                                VerticalLayout {
                                    LauncherToggleLine { label: "自动选择线程数"; value <=> root.auto-download-threads; }
                                    LauncherTextLine {
                                        label: "最大并发下载数";
                                        sublabel: root.auto-download-threads ? "由启动器自动决定" : "建议 16–64";
                                        value <=> root.download-threads;
                                        placeholder: "64";
                                        enabled: !root.auto-download-threads;
                                        opacity: root.auto-download-threads ? 0.55 : 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 6: Rectangle {
                horizontal-stretch: 1;
                clip: true;
                background: #eef1f89e;

                instance-content-motion := Rectangle {
                    width: 100%;
                    height: 100%;
                    states [
                        forward-out when root.instance-tab-phase == 1 && root.instance-tab-forward: {
                            x: -50px;
                            opacity: 0;
                            in { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        backward-out when root.instance-tab-phase == 1 && !root.instance-tab-forward: {
                            x: 50px;
                            opacity: 0;
                            in { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        forward-in when root.instance-tab-phase == 2 && root.instance-tab-forward: {
                            x: 50px;
                            opacity: 0;
                            out { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        backward-in when root.instance-tab-phase == 2 && !root.instance-tab-forward: {
                            x: -50px;
                            opacity: 0;
                            out { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                    ]

                    if root.instance-tab == 0: Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-height: instance-settings-content.preferred-height;

                        instance-settings-content := VerticalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 8px;

                        SettingsCardTitle { text: "基础设置"; }
                        SettingsGroup {
                            LauncherToggleLine {
                                label: "实例隔离";
                                sublabel: "将存档、模组和配置保存在当前实例目录";
                                value <=> root.running-directory-overridden;
                            }
                        }

                        SettingsCardTitle { text: "游戏设置"; }
                        SettingsGroup {
                            VerticalLayout {
                                SettingsSublist {
                                    title: "游戏 Java";
                                    description: root.java-type-index == 0 ? "自动选择" : (root.java-type-index == 1 ? "指定版本" : "自定义");
                                    content-height: 132px + (root.java-type-index == 0 ? 0px : 48px);
                                    show-inherit: true;
                                    overridden <=> root.java-type-overridden;
                                    expanded <=> root.settings-java-expanded;
                                    VerticalLayout {
                                        java-choice := SettingsRadioList {
                                            options: ["自动选择合适的 Java", "指定 Java 主版本", "自定义 Java 路径"];
                                            selected-index: root.java-type-index;
                                            edited => {
                                                root.java-type-index = self.selected-index;
                                                root.java-type-overridden = root.java-type-index != root.inherited-java-type-index;
                                            }
                                        }
                                        if root.java-type-index == 1: SettingsTextRow {
                                            label: "Java 主版本";
                                            overridden <=> root.custom-java-version-overridden;
                                            value <=> root.custom-java-version;
                                            auto-inherit: true;
                                            inherited-value: root.inherited-java-version;
                                            placeholder: "例如 17";
                                        }
                                        if root.java-type-index == 2: SettingsTextRow {
                                            label: "Java 可执行文件";
                                            overridden <=> root.custom-java-path-overridden;
                                            value <=> root.custom-java-path;
                                            auto-inherit: true;
                                            inherited-value: root.global-custom-java-path;
                                            placeholder: "C:/path/to/java.exe";
                                        }
                                    }
                                }

                                SettingsSublist {
                                    title: "内存";
                                    description: root.auto-memory ? "自动分配" : root.max-memory + " MiB";
                                    content-height: 88px + (root.auto-memory ? 0px : 48px);
                                    show-inherit: true;
                                    overridden <=> root.auto-memory-overridden;
                                    expanded <=> root.settings-memory-expanded;
                                    VerticalLayout {
                                        memory-choice := SettingsRadioList {
                                            options: ["自动分配", "手动分配"];
                                            selected-index: root.auto-memory ? 0 : 1;
                                            edited => {
                                                root.auto-memory = self.selected-index == 0;
                                                root.auto-memory-overridden = root.auto-memory != root.global-auto-memory;
                                            }
                                        }
                                        if !root.auto-memory: SettingsTextRow {
                                            label: "最大内存 (MiB)";
                                            overridden <=> root.max-memory-overridden;
                                            value <=> root.max-memory;
                                            auto-inherit: true;
                                            inherited-value: root.global-max-memory;
                                            placeholder: "2048";
                                        }
                                    }
                                }

                                SettingsSublist {
                                    title: "游戏窗口";
                                    description: root.window-type-index == 0 ? root.settings-width + " × " + root.settings-height
                                        : (root.window-type-index == 1 ? "全屏" : "最大化");
                                    content-height: 132px + (root.window-type-index == 0 ? 96px : 0px);
                                    show-inherit: true;
                                    overridden <=> root.window-type-overridden;
                                    expanded <=> root.settings-window-expanded;
                                    VerticalLayout {
                                        window-choice := SettingsRadioList {
                                            options: ["窗口化", "全屏", "最大化"];
                                            selected-index: root.window-type-index;
                                            edited => {
                                                root.window-type-index = self.selected-index;
                                                root.window-type-overridden = root.window-type-index != root.global-window-type-index;
                                            }
                                        }
                                        if root.window-type-index == 0: SettingsTextRow {
                                            label: "窗口宽度";
                                            overridden <=> root.width-overridden;
                                            value <=> root.settings-width;
                                            auto-inherit: true;
                                            inherited-value: root.global-window-width;
                                        }
                                        if root.window-type-index == 0: SettingsTextRow {
                                            label: "窗口高度";
                                            overridden <=> root.height-overridden;
                                            value <=> root.settings-height;
                                            auto-inherit: true;
                                            inherited-value: root.global-window-height;
                                        }
                                    }
                                }

                                SettingsSublist {
                                    title: "Quick Play";
                                    subtitle: "启动后直接进入服务器、存档或 Realms";
                                    description: ["无", "多人游戏", "单人游戏", "Realms"][root.quick-play-index];
                                    content-height: 176px + (root.quick-play-index == 0 ? 0px : 48px);
                                    show-inherit: true;
                                    overridden <=> root.quick-play-overridden;
                                    expanded <=> root.settings-quickplay-expanded;
                                    VerticalLayout {
                                        quick-choice := SettingsRadioList {
                                            options: ["不使用", "多人游戏", "单人游戏", "Realms"];
                                            selected-index: root.quick-play-index;
                                            edited => {
                                                root.quick-play-index = self.selected-index;
                                                root.quick-play-overridden = !root.quick-play-matches-global;
                                            }
                                        }
                                        if root.quick-play-index == 1: SettingsTextRow {
                                            label: "服务器地址";
                                            overridden <=> root.quick-play-overridden;
                                            value <=> root.quick-play-multiplayer;
                                            placeholder: "host:port";
                                            edited => { root.quick-play-overridden = !root.quick-play-matches-global; }
                                        }
                                        if root.quick-play-index == 2: SettingsTextRow {
                                            label: "存档文件夹名称";
                                            overridden <=> root.quick-play-overridden;
                                            value <=> root.quick-play-singleplayer;
                                            edited => { root.quick-play-overridden = !root.quick-play-matches-global; }
                                        }
                                        if root.quick-play-index == 3: SettingsTextRow {
                                            label: "Realm ID";
                                            overridden <=> root.quick-play-overridden;
                                            value <=> root.quick-play-realms;
                                            edited => { root.quick-play-overridden = !root.quick-play-matches-global; }
                                        }
                                    }
                                }

                                SettingsSublist {
                                    title: "高级启动选项";
                                    subtitle: "运行目录、游戏参数、环境变量与进程优先级";
                                    content-height: 208px;
                                    expanded <=> root.settings-advanced-expanded;
                                    VerticalLayout {
                                        SettingsTextRow { label: "运行目录"; overridden <=> root.running-directory-overridden; value <=> root.running-directory; }
                                        SettingsTextRow {
                                            label: "游戏参数";
                                            overridden <=> root.game-arguments-overridden;
                                            value <=> root.game-arguments;
                                            auto-inherit: true;
                                            inherited-value: root.global-game-arguments;
                                        }
                                        SettingsTextRow {
                                            label: "环境变量";
                                            sublabel: "一行一个 KEY=VALUE";
                                            overridden <=> root.environment-variables-overridden;
                                            value <=> root.environment-variables;
                                            auto-inherit: true;
                                            inherited-value: root.global-environment-variables;
                                        }
                                        LauncherChoiceLine {
                                            label: "进程优先级";
                                            options: ["低", "较低", "中", "较高", "高"];
                                            selected-index <=> root.process-priority-index;
                                            show-inherit: true;
                                            overridden <=> root.process-priority-overridden;
                                            auto-inherit: true;
                                            inherited-index: root.global-process-priority-index;
                                        }
                                    }
                                }
                            }
                        }

                        SettingsCardTitle { text: "启动器"; }
                        SettingsGroup {
                            VerticalLayout {
                                LauncherChoiceLine {
                                    label: "游戏启动后";
                                    options: ["关闭启动器", "隐藏启动器", "保持启动器", "游戏退出后重新显示"];
                                    selected-index <=> root.launcher-visibility-index;
                                    show-inherit: true;
                                    overridden <=> root.launcher-visibility-overridden;
                                    auto-inherit: true;
                                    inherited-index: root.global-launcher-visibility-index;
                                }
                                SettingsBoolRow {
                                    label: "输出调试信息";
                                    overridden <=> root.debug-log-overridden;
                                    value <=> root.debug-log;
                                    auto-inherit: true;
                                    inherited-value: root.global-debug-log;
                                }
                            }
                        }

                        SettingsCardTitle { text: "JVM 高级设置"; }
                        SettingsGroup {
                            VerticalLayout {
                                SettingsBoolRow {
                                    label: "不生成默认 JVM 参数";
                                    overridden <=> root.no-jvm-options-overridden;
                                    value <=> root.no-jvm-options;
                                    auto-inherit: true;
                                    inherited-value: root.global-no-jvm-options;
                                }
                                SettingsBoolRow {
                                    label: "不生成优化用 JVM 参数";
                                    overridden <=> root.no-optimizing-jvm-options-overridden;
                                    value <=> root.no-optimizing-jvm-options;
                                    auto-inherit: true;
                                    inherited-value: root.global-no-optimizing-jvm-options;
                                    enabled: !root.no-jvm-options;
                                    opacity: root.no-jvm-options ? 0.45 : 1;
                                }
                                SettingsTextRow {
                                    label: "JVM 参数";
                                    overridden <=> root.jvm-options-overridden;
                                    value <=> root.jvm-options;
                                    auto-inherit: true;
                                    inherited-value: root.global-jvm-options;
                                }
                                SettingsSublist {
                                    title: "已弃用的 JVM 内存设置";
                                    subtitle: "仅用于兼容旧版配置";
                                    content-height: 96px;
                                    expanded <=> root.settings-deprecated-memory-expanded;
                                    VerticalLayout {
                                        SettingsTextRow {
                                            label: "最小内存 (MiB)";
                                            overridden <=> root.min-memory-overridden;
                                            value <=> root.min-memory;
                                            auto-inherit: true;
                                            inherited-value: root.global-min-memory;
                                        }
                                        SettingsTextRow {
                                            label: "Metaspace (MiB)";
                                            overridden <=> root.perm-size-overridden;
                                            value <=> root.perm-size;
                                            auto-inherit: true;
                                            inherited-value: root.global-perm-size;
                                        }
                                    }
                                }
                            }
                        }

                        SettingsCardTitle { text: "自定义命令"; }
                        SettingsGroup {
                            VerticalLayout {
                                SettingsTextRow {
                                    label: "启动前执行";
                                    overridden <=> root.pre-launch-command-overridden;
                                    value <=> root.pre-launch-command;
                                    auto-inherit: true;
                                    inherited-value: root.global-pre-launch-command;
                                }
                                SettingsTextRow {
                                    label: "命令包装器";
                                    overridden <=> root.command-wrapper-overridden;
                                    value <=> root.command-wrapper;
                                    auto-inherit: true;
                                    inherited-value: root.global-command-wrapper;
                                }
                                SettingsTextRow {
                                    label: "退出后执行";
                                    overridden <=> root.post-exit-command-overridden;
                                    value <=> root.post-exit-command;
                                    auto-inherit: true;
                                    inherited-value: root.global-post-exit-command;
                                }
                            }
                        }

                        SettingsCardTitle { text: "图形设置"; }
                        SettingsGroup {
                            LauncherChoiceLine {
                                label: "图形 API";
                                sublabel: "仅对 Minecraft 26.2 及更高版本生效";
                                options: ["默认", "OpenGL", "Vulkan"];
                                selected-index <=> root.graphics-backend-index;
                                show-inherit: true;
                                overridden <=> root.graphics-backend-overridden;
                                auto-inherit: true;
                                inherited-index: root.global-graphics-backend-index;
                            }
                        }

                        SettingsCardTitle { text: "本地库"; }
                        SettingsGroup {
                            VerticalLayout {
                                SettingsBoolRow {
                                    label: "使用自定义 Natives";
                                    overridden <=> root.use-custom-natives-overridden;
                                    value <=> root.use-custom-natives;
                                    auto-inherit: true;
                                    inherited-value: root.global-use-custom-natives;
                                }
                                SettingsTextRow {
                                    label: "Natives 目录";
                                    overridden <=> root.natives-directory-overridden;
                                    value <=> root.natives-directory;
                                    auto-inherit: true;
                                    inherited-value: root.global-natives-directory;
                                }
                            }
                        }
                    }
                }

                if root.instance-tab != 0: VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 10px;
                    padding-bottom: 18px;
                    spacing: 8px;

                    if root.instance-tab >= 2: ContentCard {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            SettingsToolbarButton {
                                icon-path: Icons.refresh;
                                label: "刷新";
                                clicked => { root.refresh-instance-content(root.instance-tab); }
                            }
                            if root.instance-tab >= 2: SettingsToolbarButton {
                                icon-path: Icons.folder-open;
                                label: "打开文件夹";
                                clicked => { root.open-instance-content-folder(root.instance-tab); }
                            }
                            if root.instance-tab >= 2 && root.instance-tab <= 4: SettingsToolbarButton {
                                icon-path: Icons.add;
                                label: "从本地安装";
                                clicked => { root.install-local-instance-content(root.instance-tab); }
                            }
                            if root.instance-tab >= 2 && root.instance-tab <= 4: SettingsToolbarButton {
                                icon-path: Icons.refresh;
                                label: "检查更新";
                                clicked => { root.check-instance-content-updates(root.instance-tab); }
                            }
                            if root.instance-tab == 5: SettingsToolbarButton {
                                icon-path: Icons.add;
                                label: "导入世界";
                                clicked => { root.import-world(); }
                            }
                            if root.instance-tab >= 2 && root.instance-tab <= 4: SettingsToolbarButton {
                                icon-path: Icons.download;
                                label: "下载";
                                clicked => {
                                    root.mod-search-kind = root.instance-tab == 2 ? 0
                                        : (root.instance-tab == 3 ? 1 : 2);
                                    root.download-section = root.instance-tab == 2 ? 2
                                        : (root.instance-tab == 3 ? 3 : 4);
                                    root.mod-category-index = 0;
                                    root.mod-detail-open = false;
                                    root.download-tab = 1;
                                    root.download-return-instance = true;
                                    root.navigate-to(3, 1);
                                    root.search-mods();
                                }
                            }
                        }
                    }

                    ContentCard {
                        vertical-stretch: 1;

                        if root.content-page-loading: VerticalLayout {
                            alignment: center;
                            Text { text: "正在刷新…"; color: #77737d; font-size: 13px; horizontal-alignment: center; }
                        }
                        if !root.content-page-loading && root.content-page-count == 0: VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.instance-tab == 1 ? "未检测到额外安装组件"
                                    : (root.instance-tab == 2 ? "没有已安装的模组"
                                    : (root.instance-tab == 3 ? "没有已安装的资源包"
                                    : (root.instance-tab == 4 ? "没有已安装的光影" : "没有世界")));
                                color: #77737d;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                        if !root.content-page-loading && root.instance-tab == 5 && root.world-items.length > 0: ListView {
                            for row[i] in root.world-items: Rectangle {
                                height: 58px;
                                background: world-row-hover.pressed ? #e3e4ee
                                    : (world-row-hover.has-hover ? #f1f1f6 : transparent);
                                world-row-hover := TouchArea {
                                    clicked => {
                                        root.open-world-detail(row.folder-name);
                                        root.navigate-to(8, 1);
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        if row.has-icon: Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 4px;
                                            clip: true;
                                            Image {
                                                source: row.icon;
                                                width: 100%;
                                                height: 100%;
                                                image-fit: cover;
                                            }
                                        }
                                        if !row.has-icon: IconGlyph {
                                            d: Icons.public-icon;
                                            fill: row.locked ? #92909a : #5968c2;
                                            width: 24px;
                                            height: 24px;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: row.name; color: #292731; font-size: 13px; overflow: elide; }
                                            if row.game-version != "": Rectangle {
                                                horizontal-stretch: 0;
                                                width: version-tag.preferred-width + 10px;
                                                background: #e8e8f2;
                                                border-radius: 3px;
                                                version-tag := Text {
                                                    text: row.game-version;
                                                    color: #55535c;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            if row.locked: Rectangle {
                                                horizontal-stretch: 0;
                                                width: locked-tag.preferred-width + 10px;
                                                background: #f7e2e2;
                                                border-radius: 3px;
                                                locked-tag := Text {
                                                    text: "使用中";
                                                    color: #ba1a1a;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        Text {
                                            text: row.last-played == "" ? row.folder-name
                                                : "上一次游戏时间: " + row.last-played;
                                            color: #77737d;
                                            font-size: 10px;
                                            overflow: elide;
                                        }
                                    }
                                    // SmallIconButton 只声明了 width，高度靠所在的
                                    // HorizontalLayout 撑满行高——**不能**再套一层
                                    // VerticalLayout{alignment:center}，那样触摸区
                                    // 高度会塌成 0（图标是绝对定位的，照样画得出来，
                                    // 于是变成"看得见但点不动"）。
                                    if row.supports-quick-play: SmallIconButton {
                                        icon-path: Icons.rocket-launch;
                                        icon-color: #555;
                                        enabled: !row.locked;
                                        clicked => { root.launch-world(row.folder-name); }
                                    }
                                    world-menu-button := SmallIconButton {
                                        icon-path: Icons.more-vert;
                                        icon-color: #555;
                                        clicked => {
                                            root.world-menu-folder = row.folder-name;
                                            root.world-menu-name = row.name;
                                            root.world-menu-locked = row.locked;
                                            root.world-menu-quick-play = row.supports-quick-play;
                                            root.world-menu-input = row.folder-name;
                                            root.world-menu-page = 0;
                                            root.world-menu-x = world-menu-button.absolute-position.x;
                                            root.world-menu-y = world-menu-button.absolute-position.y;
                                            root.reveal-world-menu();
                                        }
                                    }
                                }
                                if i + 1 < root.world-items.length: Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: #d8d7df;
                                }
                            }
                        }
                        if !root.content-page-loading && root.instance-tab != 5 && root.instance-content-items.length > 0: ListView {
                            for row[i] in root.instance-content-items: Rectangle {
                                height: 58px;
                                background: content-row-hover.pressed ? #e3e4ee
                                    : (content-row-hover.has-hover ? #f1f1f6 : transparent);
                                content-row-hover := TouchArea {}
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    if root.instance-tab == 1: VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: row.file-name == "" ? @image-url("assets/grass.png")
                                                : (row.file-name == "forge" ? @image-url("assets/forge.png")
                                                : (row.file-name == "neoforge" ? @image-url("assets/neoforge.png")
                                                : (row.file-name == "optifine" ? @image-url("assets/optifine.png")
                                                : (row.file-name == "fabric" ? @image-url("assets/fabric.png")
                                                : @image-url("assets/quilt.png")))));
                                            width: 28px;
                                            height: 28px;
                                            image-fit: contain;
                                        }
                                    }
                                    if root.instance-tab != 1: VerticalLayout {
                                        alignment: center;
                                        if row.online-icon: Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 4px;
                                            clip: true;
                                            Image {
                                                source: row.icon;
                                                width: 100%;
                                                height: 100%;
                                                image-fit: cover;
                                                opacity: row.enabled ? 1 : 0.55;
                                            }
                                        }
                                        if !row.online-icon: IconGlyph {
                                            d: root.instance-tab == 2 ? Icons.extension
                                                : (root.instance-tab == 3 ? Icons.texture
                                                : (root.instance-tab == 4 ? Icons.wb-sunny : Icons.public-icon));
                                            fill: row.enabled ? #5968c2 : #92909a;
                                            width: 24px;
                                            height: 24px;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: row.name; color: row.enabled || (root.instance-tab == 1 && row.directory) ? #292731 : #85828c; font-size: 13px; overflow: elide; }
                                        Text { text: row.detail; color: #77737d; font-size: 10px; overflow: elide; }
                                    }
                                    if root.instance-tab == 2: VerticalLayout {
                                        alignment: center;
                                        MaterialSwitch {
                                            checked: row.enabled;
                                            edited => {
                                                root.toggle-instance-content(root.instance-tab, row.file-name);
                                            }
                                        }
                                    }
                                    if root.instance-tab == 1 && row.directory && row.file-name != "": SmallIconButton {
                                        icon-path: Icons.refresh;
                                        icon-color: #555;
                                        clicked => {
                                            root.loader-picker-instance-mode = true;
                                            root.loader-picker-kind = row.file-name == "forge" ? 1
                                                : (row.file-name == "neoforge" ? 2
                                                : (row.file-name == "optifine" ? 3
                                                : (row.file-name == "fabric" ? 4 : 5)));
                                            root.install-game-version = root.instance-game-version;
                                            root.loader-filter-text = "";
                                            root.navigate-to(5, 1);
                                            root.request-loader-versions(root.loader-picker-kind, root.instance-game-version);
                                        }
                                    }
                                    if root.instance-tab == 1 && row.enabled && row.file-name != "": SmallIconButton {
                                        icon-path: Icons.close;
                                        icon-color: #555;
                                        clicked => {
                                            root.delete-instance-content(root.instance-tab, row.file-name);
                                        }
                                    }
                                    if root.instance-tab >= 2: SmallIconButton {
                                        icon-path: Icons.delete-icon;
                                        icon-color: i == root.instance-content-delete-confirm-index ? #c62828 : #555;
                                        clicked => {
                                            if i == root.instance-content-delete-confirm-index {
                                                root.delete-instance-content(root.instance-tab, row.file-name);
                                                root.instance-content-delete-confirm-index = -1;
                                            } else {
                                                root.instance-content-delete-confirm-index = i;
                                            }
                                        }
                                    }
                                }
                                if i + 1 < root.instance-content-items.length: Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: #d8d7df;
                                }
                            }
                        }
                    }
                }
                }
            }

            if root.page == 8: Rectangle {
                clip: true;
                background: #eef1f89e;

                world-detail-content-motion := Rectangle {
                    width: 100%;
                    height: 100%;
                    states [
                        forward-out when root.world-detail-tab-phase == 1 && root.world-detail-tab-forward: {
                            x: -50px;
                            opacity: 0;
                            in { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        backward-out when root.world-detail-tab-phase == 1 && !root.world-detail-tab-forward: {
                            x: 50px;
                            opacity: 0;
                            in { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        forward-in when root.world-detail-tab-phase == 2 && root.world-detail-tab-forward: {
                            x: 50px;
                            opacity: 0;
                            out { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                        backward-in when root.world-detail-tab-phase == 2 && !root.world-detail-tab-forward: {
                            x: -50px;
                            opacity: 0;
                            out { animate x, opacity { duration: 100ms; easing: ease; } }
                        }
                    ]
                    if root.world-detail-tab == 0: Flickable {
                        viewport-height: world-info-content.preferred-height;
                        world-info-content := VerticalLayout {
                            alignment: start;
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 10px;
                            padding-bottom: 18px;
                            spacing: 8px;

                            if root.world-detail-read-only: Rectangle {
                                height: 34px;
                                background: #fdeaea;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        IconGlyph { d: Icons.warning; fill: #ba1a1a; width: 16px; height: 16px; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "该世界正在使用中，无法修改。请关闭游戏后重试。";
                                            color: #ba1a1a;
                                            font-size: 12px;
                                        }
                                    }
                                }
                            }

                            SettingsCardTitle { text: "世界信息"; }
                            SettingsGroup {
                                VerticalLayout {
                                    LauncherTextLine {
                                        label: "世界名称";
                                        enabled: !root.world-detail-read-only;
                                        value <=> root.world-detail-name;
                                        edited => { root.set-world-name(root.world-detail-name); }
                                    }
                                    LauncherValueLine { label: "游戏版本"; value: root.world-detail-version; }
                                    LauncherSettingLine {
                                        label: "世界图标";
                                        sublabel: "必须是 64×64 的 PNG";
                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: end;
                                                VerticalLayout {
                                                    alignment: center;
                                                    if root.world-detail-has-icon: Rectangle {
                                                        width: 32px;
                                                        height: 32px;
                                                        border-radius: 4px;
                                                        clip: true;
                                                        Image {
                                                            source: root.world-detail-icon;
                                                            width: 100%;
                                                            height: 100%;
                                                            image-fit: cover;
                                                        }
                                                    }
                                                    if !root.world-detail-has-icon: IconGlyph {
                                                        d: Icons.public-icon;
                                                        fill: #92909a;
                                                        width: 24px;
                                                        height: 24px;
                                                    }
                                                }
                                                SmallIconButton {
                                                    icon-path: Icons.edit;
                                                    enabled: !root.world-detail-read-only;
                                                    clicked => { root.change-world-icon(); }
                                                }
                                                SmallIconButton {
                                                    icon-path: Icons.close;
                                                    enabled: !root.world-detail-read-only && root.world-detail-has-icon;
                                                    clicked => { root.clear-world-icon(); }
                                                }
                                            }
                                        }
                                    }
                                    LauncherSettingLine {
                                        label: "种子";
                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                 spacing: 8px;
                                                 alignment: end;
                                                 SmallIconButton {
                                                    icon-path: Icons.content-copy;
                                                    enabled: root.world-detail-seed != "";
                                                    clicked => { root.copy-world-seed(); }
                                                 }
                                                 seed-value := Rectangle {
                                                     width: 150px;
                                                     height: 30px;
                                                     seed-hover := TouchArea {}
                                                     Image {
                                                         width: parent.width;
                                                         height: parent.height;
                                                         source: root.world-detail-seed-blurred;
                                                         image-fit: contain;
                                                         opacity: seed-hover.has-hover ? 0 : 1;
                                                         animate opacity { duration: 100ms; }
                                                     }
                                                     Text {
                                                         width: parent.width;
                                                         height: parent.height;
                                                         text: root.world-detail-seed == "" ? "—" : root.world-detail-seed;
                                                         color: #55535c;
                                                         font-size: 12px;
                                                         horizontal-alignment: right;
                                                         vertical-alignment: center;
                                                         overflow: elide;
                                                         opacity: seed-hover.has-hover || root.world-detail-seed == "" ? 1 : 0;
                                                         animate opacity { duration: 100ms; }
                                                     }
                                                 }
                                             }
                                         }
                                    }
                                    LauncherValueLine { label: "世界出生点"; value: root.world-detail-spawn; }
                                    LauncherValueLine { label: "上一次游戏时间"; value: root.world-detail-last-played; }
                                    LauncherValueLine { label: "游戏时长"; value: root.world-detail-play-time; }
                                    LauncherToggleLine {
                                        label: "允许命令(作弊)";
                                        enabled: !root.world-detail-read-only && root.world-allow-commands-available;
                                        value <=> root.world-allow-commands;
                                        edited => { root.set-world-allow-commands(root.world-allow-commands); }
                                    }
                                    LauncherToggleLine {
                                        label: "生成建筑";
                                        enabled: !root.world-detail-read-only && root.world-generate-features-available;
                                        value <=> root.world-generate-features;
                                        edited => { root.set-world-generate-features(root.world-generate-features); }
                                    }
                                    LauncherChoiceLine {
                                        label: "难度";
                                        enabled: !root.world-detail-read-only && root.world-difficulty-available;
                                        options: ["和平", "简单", "普通", "困难"];
                                        selected-index <=> root.world-difficulty-index;
                                        edited => { root.set-world-difficulty(root.world-difficulty-index); }
                                    }
                                    LauncherToggleLine {
                                        label: "锁定难度";
                                        enabled: !root.world-detail-read-only && root.world-difficulty-locked-available;
                                        value <=> root.world-difficulty-locked;
                                        edited => { root.set-world-difficulty-locked(root.world-difficulty-locked); }
                                    }
                                }
                            }

                            if root.world-has-player: SettingsCardTitle { text: "玩家信息"; }
                            if root.world-has-player: SettingsGroup {
                                VerticalLayout {
                                    LauncherValueLine { label: "位置"; value: root.world-player-location; }
                                    LauncherValueLine { label: "上次死亡位置"; value: root.world-player-death; }
                                    LauncherValueLine { label: "床/重生锚位置"; value: root.world-player-respawn; }
                                    LauncherChoiceLine {
                                        label: "游戏模式";
                                        enabled: !root.world-detail-read-only && root.world-game-type-available;
                                        options: ["生存", "创造", "冒险", "旁观", "极限"];
                                        selected-index <=> root.world-game-type-index;
                                        edited => { root.set-world-game-type(root.world-game-type-index); }
                                    }
                                    LauncherTextLine {
                                        label: "生命值";
                                        enabled: !root.world-detail-read-only;
                                        value <=> root.world-player-health;
                                        edited => { root.save-world-player-stats(); }
                                    }
                                    LauncherTextLine {
                                        label: "饥饿值";
                                        enabled: !root.world-detail-read-only;
                                        value <=> root.world-player-food;
                                        edited => { root.save-world-player-stats(); }
                                    }
                                    LauncherTextLine {
                                        label: "饱和度";
                                        enabled: !root.world-detail-read-only;
                                        value <=> root.world-player-saturation;
                                        edited => { root.save-world-player-stats(); }
                                    }
                                    LauncherTextLine {
                                        label: "经验等级";
                                        enabled: !root.world-detail-read-only;
                                        value <=> root.world-player-xp;
                                        edited => { root.save-world-player-stats(); }
                                    }
                                }
                            }
                        }
                    }

                    if root.world-detail-tab == 1: VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 10px;
                        padding-bottom: 18px;
                        spacing: 8px;

                        if root.world-detail-read-only: Rectangle {
                            height: 34px;
                            background: #fdeaea;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    IconGlyph { d: Icons.warning; fill: #ba1a1a; width: 16px; height: 16px; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "该世界正在使用中，无法修改。请关闭游戏后重试。";
                                        color: #ba1a1a;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }

                    ContentCard {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            SettingsToolbarButton {
                                icon-path: Icons.refresh;
                                label: "刷新";
                                clicked => { root.refresh-world-backups(); }
                            }
                            SettingsToolbarButton {
                                icon-path: Icons.archive;
                                label: "创建新备份";
                                clicked => { root.create-world-backup(); }
                            }
                            SettingsToolbarButton {
                                icon-path: Icons.folder-open;
                                label: "打开备份文件夹";
                                clicked => { root.open-world-backups-folder(); }
                            }
                        }
                    }
                    ContentCard {
                        vertical-stretch: 1;

                        if root.world-backups-loading: VerticalLayout {
                            alignment: center;
                            Text { text: "正在刷新…"; color: #77737d; font-size: 13px; horizontal-alignment: center; }
                        }
                        if !root.world-backups-loading && root.world-backups.length == 0: VerticalLayout {
                            alignment: center;
                            Text { text: "没有备份"; color: #77737d; font-size: 13px; horizontal-alignment: center; }
                        }
                        if !root.world-backups-loading && root.world-backups.length > 0: ListView {
                            for row[i] in root.world-backups: Rectangle {
                                height: 58px;
                                background: backup-row-hover.has-hover ? #f1f1f6 : transparent;
                                backup-row-hover := TouchArea {}
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        IconGlyph { d: Icons.archive; fill: #5968c2; width: 24px; height: 24px; }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: row.world-name; color: #292731; font-size: 13px; overflow: elide; }
                                            if row.game-version != "": Rectangle {
                                                horizontal-stretch: 0;
                                                width: backup-version-tag.preferred-width + 10px;
                                                background: #e8e8f2;
                                                border-radius: 3px;
                                                backup-version-tag := Text {
                                                    text: row.game-version;
                                                    color: #55535c;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        Text { text: row.time; color: #77737d; font-size: 10px; overflow: elide; }
                                    }
                                    SmallIconButton {
                                        icon-path: Icons.delete-icon;
                                        icon-color: i == root.world-backup-delete-index ? #c62828 : #555;
                                        clicked => {
                                            if i == root.world-backup-delete-index {
                                                root.delete-world-backup(row.file-name);
                                                root.world-backup-delete-index = -1;
                                            } else {
                                                root.world-backup-delete-index = i;
                                            }
                                        }
                                    }
                                }
                                if i + 1 < root.world-backups.length: Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: #d8d7df;
                                }
                            }
                        }
                    }
                    }

                    if root.world-detail-tab == 2: VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 10px;
                        padding-bottom: 18px;
                        spacing: 8px;

                        if root.world-detail-read-only: Rectangle {
                            height: 34px;
                            background: #fdeaea;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    IconGlyph { d: Icons.warning; fill: #ba1a1a; width: 16px; height: 16px; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "该世界正在使用中，无法修改。请关闭游戏后重试。";
                                        color: #ba1a1a;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }

                    ContentCard {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            SettingsToolbarButton {
                                icon-path: Icons.refresh;
                                label: "刷新";
                                clicked => { root.refresh-world-datapacks(); }
                            }
                            SettingsToolbarButton {
                                icon-path: Icons.add;
                                label: "添加数据包";
                                clicked => { root.install-world-datapack(); }
                            }
                            SettingsToolbarButton {
                                icon-path: Icons.folder-open;
                                label: "打开文件夹";
                                clicked => { root.open-world-datapacks-folder(); }
                            }
                        }
                    }
                    ContentCard {
                        vertical-stretch: 1;

                        if root.world-datapacks-loading: VerticalLayout {
                            alignment: center;
                            Text { text: "正在刷新…"; color: #77737d; font-size: 13px; horizontal-alignment: center; }
                        }
                        if !root.world-datapacks-loading && root.world-datapacks.length == 0: VerticalLayout {
                            alignment: center;
                            Text { text: "没有数据包"; color: #77737d; font-size: 13px; horizontal-alignment: center; }
                        }
                        if !root.world-datapacks-loading && root.world-datapacks.length > 0: ListView {
                            for row[i] in root.world-datapacks: Rectangle {
                                height: 58px;
                                background: datapack-row-hover.has-hover ? #f1f1f6 : transparent;
                                datapack-row-hover := TouchArea {}
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        IconGlyph {
                                            d: Icons.extension;
                                            fill: row.enabled ? #5968c2 : #92909a;
                                            width: 24px;
                                            height: 24px;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: row.name;
                                            color: row.enabled ? #292731 : #85828c;
                                            font-size: 13px;
                                            overflow: elide;
                                        }
                                        Text { text: row.description; color: #77737d; font-size: 10px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        MaterialSwitch {
                                            checked: row.enabled;
                                            edited => { root.toggle-world-datapack(row.file-name); }
                                        }
                                    }
                                    SmallIconButton {
                                        icon-path: Icons.delete-icon;
                                        icon-color: i == root.world-datapack-delete-index ? #c62828 : #555;
                                        clicked => {
                                            if i == root.world-datapack-delete-index {
                                                root.delete-world-datapack(row.file-name);
                                                root.world-datapack-delete-index = -1;
                                            } else {
                                                root.world-datapack-delete-index = i;
                                            }
                                        }
                                    }
                                }
                                if i + 1 < root.world-datapacks.length: Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: #d8d7df;
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
        }
    }

    if root.page-transition-active: TouchArea {
        width: 100%;
        height: 100%;
    }

    // 与世界管理菜单使用相同的窗口级事件路径，避免 PopupWindow 吞掉父组件回调。
    if root.instance-menu-open: Rectangle {
        width: 100%;
        height: 100%;
        TouchArea { clicked => { root.dismiss-instance-menu(); } }
        Rectangle {
            property <length> menu-height: root.instance-menu-page == 0 ? 362px
                : (root.instance-menu-page == 3 ? 224px
                : (root.instance-menu-page == 4 ? 148px : 132px));
            width: root.instance-menu-page == 3 ? 320px : 250px;
            height: self.menu-height;
            x: max(8px, min(root.instance-menu-x, root.width - self.width - 8px));
            property <length> shown-y: max(8px, min(
                root.instance-menu-y - self.height,
                root.height - self.height - 8px
            ));
            y: root.instance-menu-revealed ? self.shown-y : self.shown-y + 4px;
            opacity: root.instance-menu-revealed ? 1 : 0;
            background: white;
            border-radius: 6px;
            clip: true;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000055;
            animate y, opacity {
                duration: 140ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            if root.instance-menu-page == 0: VerticalLayout {
                ManagementMenuItem {
                    icon-path: Icons.rocket-launch;
                    text: "测试游戏";
                    clicked => {
                        root.dismiss-instance-menu();
                        root.launch-instance(root.settings-instance-id);
                    }
                }
                ManagementMenuItem {
                    icon-path: Icons.list;
                    text: "生成启动脚本";
                    clicked => {
                        root.dismiss-instance-menu();
                        if root.accounts.length == 0 {
                            root.show-account-page();
                        } else {
                            root.generate-launch-script(root.settings-instance-id);
                        }
                    }
                }
                Rectangle { height: 1px; background: #dedce5; }
                ManagementMenuItem {
                    icon-path: Icons.edit;
                    text: "重命名该实例";
                    clicked => { root.instance-menu-page = 1; }
                }
                ManagementMenuItem {
                    icon-path: Icons.content-copy;
                    text: "复制游戏实例";
                    clicked => {
                        root.dismiss-instance-menu();
                        root.duplicate-instance(root.settings-instance-id);
                    }
                }
                ManagementMenuItem {
                    icon-path: Icons.delete-icon;
                    text: "删除该实例";
                    dangerous: true;
                    clicked => { root.instance-menu-page = 2; }
                }
                ManagementMenuItem {
                    icon-path: Icons.package2;
                    text: "导出整合包";
                    clicked => { root.instance-menu-page = 3; }
                }
                Rectangle { height: 1px; background: #dedce5; }
                ManagementMenuItem {
                    icon-path: Icons.delete-icon;
                    text: "删除全部资源文件";
                    clicked => {
                        root.instance-menu-cleanup-kind = 0;
                        root.instance-menu-page = 4;
                    }
                }
                ManagementMenuItem {
                    icon-path: Icons.delete-icon;
                    text: "删除全部依赖库";
                    clicked => {
                        root.instance-menu-cleanup-kind = 1;
                        root.instance-menu-page = 4;
                    }
                }
                ManagementMenuItem {
                    icon-path: Icons.delete-icon;
                    text: "清理游戏日志";
                    clicked => {
                        root.instance-menu-cleanup-kind = 2;
                        root.instance-menu-page = 4;
                    }
                }
            }

            if root.instance-menu-page == 1: VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text { text: "请输入新的实例名称"; color: #302e37; font-size: 13px; }
                ToolbarTextField { text <=> root.instance-menu-input; }
                HorizontalLayout {
                    alignment: end;
                    DialogActionButton {
                        text: "确定";
                        text-color: #4f5fb4;
                        enabled: root.instance-menu-input != ""
                            && root.instance-menu-input != root.settings-instance-id;
                        clicked => {
                            root.dismiss-instance-menu();
                            root.rename-instance(root.settings-instance-id, root.instance-menu-input);
                        }
                    }
                    DialogActionButton {
                        text: "取消";
                        clicked => { root.instance-menu-page = 0; }
                    }
                }
            }

            if root.instance-menu-page == 2: VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Text {
                    text: "确定删除实例“" + root.settings-instance-id + "”？";
                    color: #302e37;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text { text: "此操作无法撤销。"; color: #ba1a1a; font-size: 11px; }
                HorizontalLayout {
                    alignment: end;
                    DialogActionButton {
                        text: "删除";
                        text-color: #ba1a1a;
                        clicked => {
                            root.dismiss-instance-menu();
                            root.delete-instance(root.settings-instance-id);
                        }
                    }
                    DialogActionButton {
                        text: "取消";
                        clicked => { root.instance-menu-page = 0; }
                    }
                }
            }

            if root.instance-menu-page == 3: VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text { text: "导出 Modrinth 整合包"; color: #302e37; font-size: 14px; font-weight: 700; }
                HorizontalLayout {
                    Text { text: "名称"; color: #55535c; font-size: 12px; vertical-alignment: center; width: 58px; }
                    ToolbarTextField { text <=> root.instance-menu-export-name; }
                }
                HorizontalLayout {
                    Text { text: "版本"; color: #55535c; font-size: 12px; vertical-alignment: center; width: 58px; }
                    ToolbarTextField { text <=> root.instance-menu-export-version; }
                }
                HorizontalLayout {
                    Text { text: "简介"; color: #55535c; font-size: 12px; vertical-alignment: center; width: 58px; }
                    ToolbarTextField { text <=> root.instance-menu-export-summary; }
                }
                HorizontalLayout {
                    alignment: end;
                    DialogActionButton {
                        text: "导出";
                        text-color: #4f5fb4;
                        enabled: root.instance-menu-export-name != ""
                            && root.instance-menu-export-version != "";
                        clicked => {
                            root.dismiss-instance-menu();
                            root.export-instance-modpack(
                                root.settings-instance-id,
                                root.instance-menu-export-name,
                                root.instance-menu-export-version,
                                root.instance-menu-export-summary
                            );
                        }
                    }
                    DialogActionButton {
                        text: "取消";
                        clicked => { root.instance-menu-page = 0; }
                    }
                }
            }

            if root.instance-menu-page == 4: VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Text {
                    text: root.instance-menu-cleanup-kind == 0 ? "确定删除全部共享资源文件？"
                        : (root.instance-menu-cleanup-kind == 1
                        ? "确定删除全部共享依赖库？"
                        : "确定清理游戏日志与崩溃报告？");
                    color: #302e37;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.instance-menu-cleanup-kind == 2
                        ? "不会删除存档、模组或配置。"
                        : "下次启动游戏时会重新下载缺失文件。";
                    color: #6c6973;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    DialogActionButton {
                        text: "确定";
                        text-color: #ba1a1a;
                        clicked => {
                            root.dismiss-instance-menu();
                            root.clean-instance-data(
                                root.settings-instance-id,
                                root.instance-menu-cleanup-kind
                            );
                        }
                    }
                    DialogActionButton {
                        text: "取消";
                        clicked => { root.instance-menu-page = 0; }
                    }
                }
            }
        }
    }

    if root.world-menu-open: Rectangle {
        width: 100%;
        height: 100%;
        TouchArea { clicked => { root.dismiss-world-menu(); } }
        Rectangle {
            width: 236px;
            height: root.world-menu-page == 0
                ? (root.world-menu-quick-play ? 282px : 201px)
                : (root.world-menu-page == 2 ? 148px : 132px);
            x: max(8px, min(root.world-menu-x + 28px - self.width, root.width - self.width - 8px));
            property <length> shown-y: max(8px, min(root.world-menu-y + 30px, root.height - self.height - 8px));
            y: root.world-menu-revealed ? self.shown-y : self.shown-y + 4px;
            opacity: root.world-menu-revealed ? 1 : 0;
            background: white;
            border-radius: 6px;
            clip: true;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000055;
            animate y, opacity {
                duration: 140ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            if root.world-menu-page == 0: VerticalLayout {
                alignment: start;
                if root.world-menu-quick-play: ManagementMenuItem {
                    icon-path: Icons.rocket-launch;
                    text: "启动并进入世界";
                    enabled: !root.world-menu-locked;
                    clicked => {
                        root.dismiss-world-menu();
                        root.launch-world(root.world-menu-folder);
                    }
                }
                if root.world-menu-quick-play: ManagementMenuItem {
                    icon-path: Icons.list;
                    text: "生成启动脚本";
                    clicked => {
                        root.dismiss-world-menu();
                        root.generate-world-launch-script(root.world-menu-folder);
                    }
                }
                if root.world-menu-quick-play: Rectangle { height: 1px; background: #dedce5; }
                ManagementMenuItem {
                    icon-path: Icons.package2;
                    text: "导出此世界";
                    enabled: !root.world-menu-locked;
                    clicked => {
                        root.dismiss-world-menu();
                        root.export-world(root.world-menu-folder);
                    }
                }
                ManagementMenuItem {
                    icon-path: Icons.content-copy;
                    text: "复制此世界";
                    enabled: !root.world-menu-locked;
                    clicked => {
                        root.world-menu-input = root.world-menu-folder + " - 副本";
                        root.world-menu-page = 1;
                    }
                }
                ManagementMenuItem {
                    icon-path: Icons.edit;
                    text: "重命名此世界";
                    enabled: !root.world-menu-locked;
                    clicked => {
                        root.world-menu-input = root.world-menu-folder;
                        root.world-menu-page = 3;
                    }
                }
                ManagementMenuItem {
                    icon-path: Icons.delete-icon;
                    text: "删除此世界";
                    dangerous: true;
                    enabled: !root.world-menu-locked;
                    clicked => { root.world-menu-page = 2; }
                }
                Rectangle { height: 1px; background: #dedce5; }
                ManagementMenuItem {
                    icon-path: Icons.folder-open;
                    text: "打开世界文件夹";
                    clicked => {
                        root.dismiss-world-menu();
                        root.open-world-folder(root.world-menu-folder);
                    }
                }
            }

            if root.world-menu-page == 1 || root.world-menu-page == 3: VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: root.world-menu-page == 1 ? "请输入副本的名称" : "请输入新的世界名称";
                    color: #302e37;
                    font-size: 13px;
                }
                ToolbarTextField { text <=> root.world-menu-input; }
                HorizontalLayout {
                    alignment: end;
                    DialogActionButton {
                        text: "确定";
                        text-color: #4f5fb4;
                        enabled: root.world-menu-input != "" && root.world-menu-input != root.world-menu-folder;
                        clicked => {
                            root.dismiss-world-menu();
                            if root.world-menu-page == 1 {
                                root.duplicate-world(root.world-menu-folder, root.world-menu-input);
                            } else {
                                root.rename-world(root.world-menu-folder, root.world-menu-input);
                            }
                        }
                    }
                    DialogActionButton { text: "取消"; clicked => { root.world-menu-page = 0; } }
                }
            }

            if root.world-menu-page == 2: VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Text {
                    text: "确定删除世界“" + root.world-menu-name + "”？";
                    color: #302e37;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text { text: "此操作无法撤销。"; color: #ba1a1a; font-size: 11px; }
                HorizontalLayout {
                    alignment: end;
                    DialogActionButton {
                        text: "删除";
                        text-color: #ba1a1a;
                        clicked => {
                            root.dismiss-world-menu();
                            root.delete-world(root.world-menu-folder);
                        }
                    }
                    DialogActionButton { text: "取消"; clicked => { root.world-menu-page = 0; } }
                }
            }
        }
    }

    if root.mod-version-dialog-mounted: ModalOverlay {
        shown: root.mod-version-dialog-visible;
        available-height: root.height - 48px;
        Rectangle {
            width: 470px * parent.content-scale;
            height: 290px * parent.content-scale;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #e9e7ef;
            border-radius: 4px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: "安装 " + root.selected-mod-version-title;
                    font-size: 18px;
                    font-weight: 700;
                    color: #242129;
                }
                Rectangle {
                    height: 70px;
                    background: #ffffffaa;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        IconGlyph {
                            d: Icons.check-circle;
                            fill: #4f55b3;
                            width: 28px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text { text: root.selected-mod-version-title; font-size: 14px; color: #26242c; }
                            Text { text: root.selected-mod-version-detail; font-size: 11px; color: #65626c; }
                        }
                    }
                }
                Text {
                    text: root.mod-search-kind == 3 ? "选择此版本并创建一个新的游戏实例。" : "将安装到当前选择的游戏实例。";
                    font-size: 11px;
                    color: #65626c;
                }
                if root.mod-search-kind == 3: VerticalLayout {
                    height: 48px;
                    spacing: 4px;
                    Text {
                        text: root.modpack-instance-name-conflict ? "新实例名称（名称已存在）" : "新实例名称";
                        font-size: 11px;
                        color: root.modpack-instance-name-conflict ? #ba1a1a : #4f4c56;
                    }
                    MaterialDialogField {
                        text <=> root.modpack-import-instance-name;
                        placeholder: "例如 fabulously-optimized";
                        error: root.modpack-instance-name-conflict;
                        edited => {
                            root.modpack-instance-name-conflict =
                                root.instance-name-exists(root.modpack-import-instance-name);
                        }
                    }
                }
                if root.mod-search-kind != 3: VerticalLayout {
                    height: 48px;
                    spacing: 4px;
                    Text { text: "文件名"; font-size: 11px; color: #4f4c56; }
                    MaterialDialogField {
                        text <=> root.selected-mod-file-name;
                        placeholder: "输入保存的文件名";
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    CompactButton { text: "取消"; clicked => { root.show-mod-version-dialog = false; } }
                    Rectangle {
                        width: 64px;
                        height: 32px;
                        border-radius: 4px;
                        background: (root.mod-search-kind == 3
                                && (root.modpack-import-instance-name == "" || root.modpack-instance-name-conflict))
                            || (root.mod-search-kind != 3 && root.selected-mod-file-name == "") ? #aaa
                            : (install-version-hover.pressed ? #454ab2 : (install-version-hover.has-hover ? #565bd0 : #6266d8));
                        install-version-hover := TouchArea {
                            enabled: (root.mod-search-kind == 3
                                    && root.modpack-import-instance-name != ""
                                    && !root.modpack-instance-name-conflict)
                                || (root.mod-search-kind != 3 && root.selected-mod-file-name != "");
                            clicked => {
                                root.show-mod-version-dialog = false;
                                root.install-mod-version(root.selected-mod-version-id, root.selected-mod-file-name);
                            }
                        }
                        Text { text: "安装"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                    }
                }
            }
        }
    }

    if root.copyright-dialog-mounted: ModalOverlay {
        shown: root.copyright-dialog-visible;
        available-height: root.height - 48px;

        Rectangle {
            width: min(560px, parent.width - 48px) * parent.content-scale;
            height: 374px * parent.content-scale;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #e9e7ef;
            border-radius: 5px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 22px;
                padding-bottom: 16px;
                spacing: 12px;

                HorizontalLayout {
                    height: 38px;
                    spacing: 12px;
                    IconGlyph {
                        d: Icons.help;
                        fill: #5968c2;
                        width: 28px;
                        height: 28px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "HMCL-rs";
                            font-size: 20px;
                            font-weight: 700;
                            color: #242129;
                        }
                        Text {
                            text: "非官方 Rust 重实现/衍生项目";
                            font-size: 11px;
                            color: #77737d;
                        }
                    }
                }

                Rectangle { height: 1px; background: #d3d0da; }

                VerticalLayout {
                    spacing: 5px;
                    Text { text: "上游项目"; font-size: 11px; color: #77737d; }
                    Text {
                        text: "Hello Minecraft! Launcher（HMCL）";
                        font-size: 14px;
                        font-weight: 600;
                        color: #302e37;
                    }
                    Text {
                        text: "Copyright © huangyuhui and contributors";
                        font-size: 12px;
                        color: #55515c;
                    }
                    Text {
                        text: "本项目参考 HMCL 实现，与 HMCL-dev、Mojang Studios、Microsoft 或 Modrinth 均无隶属、授权或背书关系。";
                        font-size: 12px;
                        color: #55515c;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    spacing: 5px;
                    Text { text: "许可证"; font-size: 11px; color: #77737d; }
                    Text {
                        text: "GNU General Public License version 3 only";
                        font-size: 13px;
                        font-weight: 600;
                        color: #302e37;
                    }
                    Text {
                        text: "本软件不提供任何明示或暗示担保。";
                        font-size: 12px;
                        color: #55515c;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    alignment: end;
                    DialogActionButton {
                        width: 88px;
                        text: "HMCL 项目";
                        clicked => { root.open-url("https://github.com/HMCL-dev/HMCL"); }
                    }
                    DialogActionButton {
                        width: 88px;
                        text: "查看 GPLv3";
                        clicked => { root.open-url("https://www.gnu.org/licenses/gpl-3.0.html"); }
                    }
                    DialogActionButton {
                        text: "确定";
                        text-color: #4f5fb4;
                        clicked => { root.close-copyright-dialog(); }
                    }
                }
            }
        }
    }

    if root.crash-dialog-mounted: ModalOverlay {
        shown: root.crash-dialog-visible;
        available-height: root.height - 48px;

        Rectangle {
            width: min(760px, parent.width - 48px) * parent.content-scale;
            height: min(520px, parent.height - 48px) * parent.content-scale;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #e9e7ef;
            border-radius: 5px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 22px;
                padding-bottom: 16px;
                spacing: 12px;
                HorizontalLayout {
                    height: 38px;
                    spacing: 12px;
                    IconGlyph {
                        d: Icons.warning;
                        fill: #ba1a1a;
                        width: 28px;
                        height: 28px;
                    }
                    Text {
                        text: "游戏意外退出";
                        font-size: 21px;
                        font-weight: 700;
                        color: #242129;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    height: 58px;
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: white;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: #dcdae3;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            Text { text: "游戏实例"; font-size: 10px; color: #77737d; }
                            Text {
                                text: root.crash-instance-name;
                                font-size: 13px;
                                color: #302e37;
                                overflow: elide;
                            }
                        }
                    }
                    Rectangle {
                        width: 150px;
                        background: white;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: #dcdae3;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            Text { text: "退出状态"; font-size: 10px; color: #77737d; }
                            Text {
                                text: root.crash-exit-code;
                                font-size: 13px;
                                color: #ba1a1a;
                                overflow: elide;
                            }
                        }
                    }
                }
                Text {
                    height: 22px;
                    text: "游戏没有正常结束。下面是本次运行最后的输出，可用于排查模组、Java 或显卡驱动问题。";
                    font-size: 12px;
                    color: #55515c;
                    wrap: word-wrap;
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: #202124;
                    border-radius: 5px;
                    clip: true;
                    Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;
                        viewport-height: max(crash-log-text.preferred-height + 20px, self.height);
                        crash-log-text := Text {
                            x: 10px;
                            y: 10px;
                            width: parent.width - 20px;
                            text: root.crash-log == "" ? "没有捕获到游戏输出，请检查实例的 logs 文件夹。" : root.crash-log;
                            color: #e4e4e4;
                            font-family: "Consolas";
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    alignment: end;
                    DialogActionButton {
                        width: 96px;
                        text: "打开日志文件夹";
                        clicked => { root.open-crash-log-folder(root.crash-log-folder); }
                    }
                    DialogActionButton {
                        width: 72px;
                        text: "复制日志";
                        clicked => { root.copy-text(root.crash-log); }
                    }
                    DialogActionButton {
                        text: "确定";
                        text-color: #4f5fb4;
                        clicked => { root.show-crash-dialog = false; }
                    }
                }
            }
        }
    }

    if root.game-directory-menu-open: Rectangle {
        width: 100%;
        height: 100%;
        TouchArea { clicked => { root.dismiss-game-directory-menu(); } }
        Rectangle {
            width: 220px;
            height: root.game-directory-menu-page == 0
                ? 80px : (root.game-directory-menu-page == 1 ? 132px : 148px);
            x: min(
                root.navigation-sidebar-width + 4px,
                root.width - self.width - 8px
            );
            property <length> shown-y: max(
                8px,
                min(root.game-directory-menu-y, root.height - self.height - 8px)
            );
            y: root.game-directory-menu-revealed ? self.shown-y : self.shown-y + 4px;
            opacity: root.game-directory-menu-revealed ? 1 : 0;
            background: white;
            border-radius: 6px;
            clip: true;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000055;
            animate y, opacity {
                duration: 140ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            if root.game-directory-menu-page == 0: VerticalLayout {
                ManagementMenuItem {
                    icon-path: Icons.edit;
                    text: "重命名";
                    clicked => {
                        root.game-directory-menu-input = root.game-directory-menu-name;
                        root.game-directory-menu-page = 1;
                    }
                }
                ManagementMenuItem {
                    icon-path: Icons.delete-icon;
                    text: "移除";
                    dangerous: true;
                    enabled: root.game-directory-menu-can-delete;
                    clicked => { root.game-directory-menu-page = 2; }
                }
            }

            if root.game-directory-menu-page == 1: VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: "请输入新的游戏文件夹名称";
                    color: #302e37;
                    font-size: 13px;
                }
                ToolbarTextField { text <=> root.game-directory-menu-input; }
                HorizontalLayout {
                    alignment: end;
                    DialogActionButton {
                        text: "确定";
                        text-color: #4f5fb4;
                        enabled: root.game-directory-menu-input != ""
                            && root.game-directory-menu-input != root.game-directory-menu-name;
                        clicked => {
                            root.dismiss-game-directory-menu();
                            root.rename-game-directory(
                                root.game-directory-menu-index,
                                root.game-directory-menu-input
                            );
                        }
                    }
                    DialogActionButton {
                        text: "取消";
                        clicked => { root.game-directory-menu-page = 0; }
                    }
                }
            }

            if root.game-directory-menu-page == 2: VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Text {
                    text: "从列表移除“" + root.game-directory-menu-name + "”？";
                    color: #302e37;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text { text: "磁盘中的游戏文件不会被删除。"; color: #77737d; font-size: 11px; }
                HorizontalLayout {
                    alignment: end;
                    DialogActionButton {
                        text: "移除";
                        text-color: #ba1a1a;
                        clicked => {
                            root.dismiss-game-directory-menu();
                            root.remove-game-directory(root.game-directory-menu-index);
                        }
                    }
                    DialogActionButton {
                        text: "取消";
                        clicked => { root.game-directory-menu-page = 0; }
                    }
                }
            }
        }
    }

    if root.authlib-dialog-mounted: ModalOverlay {
        shown: root.authlib-dialog-visible;
        available-height: root.height - 48px;

        Rectangle {
            width: 560px * parent.content-scale;
            height: (root.authlib-dialog-state == 4 ? 390px : 310px) * parent.content-scale;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #e9e7ef;
            border-radius: 4px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 24px;
                padding-bottom: 16px;
                spacing: 12px;

                Text {
                    height: 32px;
                    text: root.authlib-server-index < 0
                        ? "添加认证服务器" : "添加外置登录账户";
                    font-size: 20px;
                    font-weight: 700;
                    color: #242129;
                    vertical-alignment: center;
                }

                if root.authlib-dialog-state == 0: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    Text {
                        text: "认证服务器地址";
                        color: #37343c;
                        font-size: 13px;
                    }
                    auth-server-url-input := MaterialDialogField {
                        text <=> root.authlib-server-url;
                        placeholder: "例如 https://littleskin.cn/api/yggdrasil/";
                        error: root.authlib-server-url == "";
                        accepted => {
                            if root.authlib-server-url != "" {
                                root.authlib-dialog-state = 3;
                                root.authlib-login-message = "正在连接认证服务器…";
                                root.begin-auth-server-locate(root.authlib-server-url);
                            }
                        }
                    }
                    Text {
                        text: "启动器会先读取服务器公开元数据，确认名称和最终 API 地址后再保存。";
                        color: #77737d;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.authlib-dialog-state == 1: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 28px;
                        Text { width: 86px; text: "服务器名称"; color: #6d6974; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.authlib-server-name; color: #302e37; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    }
                    HorizontalLayout {
                        height: 28px;
                        Text { width: 86px; text: "服务器地址"; color: #6d6974; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.authlib-server-url; color: #302e37; font-size: 12px; vertical-alignment: center; overflow: elide; }
                    }
                    if root.authlib-server-insecure: Rectangle {
                        height: 48px;
                        background: #fff2cc;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #c8a54c;
                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text: "该服务器使用未加密的 HTTP，账户凭据可能被网络中的其他人读取。";
                            color: #6b5520;
                            font-size: 11px;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.authlib-dialog-state == 2: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 10px;
                    Text {
                        text: root.authlib-server-name + "  ·  " + root.authlib-server-url;
                        color: #66626c;
                        font-size: 11px;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        height: 40px;
                        spacing: 15px;
                        Text {
                            text: "用户名";
                            width: 54px;
                            color: #37343c;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        authlib-login-name-input := MaterialDialogField {
                            text <=> root.authlib-login-name;
                            placeholder: root.authlib-server-index >= 0
                                && root.authlib-server-index < root.auth-server-non-email-login.length
                                && root.auth-server-non-email-login[root.authlib-server-index]
                                ? "邮箱或用户名" : "邮箱";
                            error: root.authlib-login-name == "";
                        }
                    }
                    HorizontalLayout {
                        height: 40px;
                        spacing: 15px;
                        Text {
                            text: "密码";
                            width: 54px;
                            color: #37343c;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        MaterialDialogField {
                            text <=> root.authlib-login-password;
                            placeholder: "密码";
                            password-mode: true;
                            error: root.authlib-login-password == "";
                            accepted => {
                                if root.authlib-login-name != "" && root.authlib-login-password != "" {
                                    root.authlib-dialog-state = 3;
                                    root.authlib-login-message = "正在登录 " + root.authlib-server-name + "…";
                                    root.begin-authlib-login(
                                        root.authlib-server-index,
                                        root.authlib-login-name,
                                        root.authlib-login-password
                                    );
                                }
                            }
                        }
                    }
                    Text {
                        text: "密码仅用于本次认证，不会保存到磁盘。";
                        color: #77737d;
                        font-size: 11px;
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.authlib-dialog-state == 3: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 14px;
                    Text {
                        text: root.authlib-login-message;
                        color: #37343c;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "●  ●  ●";
                        color: #6266d8;
                        font-size: 16px;
                        horizontal-alignment: center;
                        opacity: root.loading-pulse ? 0.45 : 1;
                        animate opacity { duration: 250ms; }
                    }
                }

                if root.authlib-dialog-state == 4: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    Text {
                        text: "该账户拥有多个角色，请选择要添加的角色：";
                        color: #37343c;
                        font-size: 13px;
                    }
                    ContentCard {
                        vertical-stretch: 1;
                        ListView {
                            for profile[i] in root.authlib-profile-names: Rectangle {
                                height: 42px;
                                background: profile-hover.pressed ? #e2e3ed
                                    : (profile-hover.has-hover ? #f0f0f5 : transparent);
                                animate background { duration: 90ms; }
                                profile-hover := TouchArea {
                                    clicked => {
                                        root.authlib-dialog-state = 3;
                                        root.authlib-login-message = "正在选择角色 " + profile + "…";
                                        root.select-authlib-profile(i);
                                    }
                                }
                                Text {
                                    x: 14px;
                                    width: parent.width - 28px;
                                    height: parent.height;
                                    text: profile;
                                    color: #302e37;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: #e2e0e7; }
                            }
                        }
                    }
                }

                if root.authlib-dialog-state == 5: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    Rectangle {
                        height: 96px;
                        background: #f8d7da;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: #b86a72;
                        Text {
                            x: 14px;
                            y: 10px;
                            width: parent.width - 28px;
                            height: parent.height - 20px;
                            text: root.authlib-login-message;
                            color: #61343a;
                            font-size: 12px;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    alignment: end;
                    if root.authlib-dialog-state == 0: DialogActionButton {
                        text: "下一步";
                        text-color: #4f5fb4;
                        enabled: root.authlib-server-url != "";
                        clicked => {
                            root.authlib-dialog-state = 3;
                            root.authlib-login-message = "正在连接认证服务器…";
                            root.begin-auth-server-locate(root.authlib-server-url);
                        }
                    }
                    if root.authlib-dialog-state == 1: DialogActionButton {
                        text: "上一步";
                        clicked => { root.authlib-dialog-state = 0; }
                    }
                    if root.authlib-dialog-state == 1: DialogActionButton {
                        text: "完成";
                        text-color: #4f5fb4;
                        clicked => { root.confirm-auth-server(); }
                    }
                    if root.authlib-dialog-state == 2: DialogActionButton {
                        text: "登录";
                        text-color: #4f5fb4;
                        enabled: root.authlib-login-name != "" && root.authlib-login-password != "";
                        clicked => {
                            root.authlib-dialog-state = 3;
                            root.authlib-login-message = "正在登录 " + root.authlib-server-name + "…";
                            root.begin-authlib-login(
                                root.authlib-server-index,
                                root.authlib-login-name,
                                root.authlib-login-password
                            );
                        }
                    }
                    if root.authlib-dialog-state == 5: DialogActionButton {
                        text: "返回";
                        text-color: #4f5fb4;
                        clicked => {
                            root.authlib-dialog-state = root.authlib-server-index < 0 ? 0 : 2;
                            root.authlib-login-message = "";
                        }
                    }
                    DialogActionButton {
                        text: "取消";
                        clicked => { root.close-authlib-dialog(); }
                    }
                }
            }
        }
    }

    if root.microsoft-dialog-mounted: ModalOverlay {
        shown: root.microsoft-dialog-visible;
        available-height: root.height - 48px;

        Rectangle {
            width: 560px * parent.content-scale;
            height: 330px * parent.content-scale;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #e9e7ef;
            border-radius: 4px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 24px;
                padding-bottom: 16px;
                spacing: 12px;

                Text {
                    height: 32px;
                    text: "添加微软账户";
                    font-size: 20px;
                    font-weight: 700;
                    color: #242129;
                    vertical-alignment: center;
                }

                if root.microsoft-login-state == 0 || root.microsoft-login-state == 2: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 14px;
                    Text {
                        text: root.microsoft-login-state == 0
                            ? "正在连接 Microsoft…" : "授权完成，正在获取 Minecraft 档案…";
                        color: #37343c;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "●  ●  ●";
                        color: #6266d8;
                        font-size: 16px;
                        horizontal-alignment: center;
                        opacity: root.loading-pulse ? 0.45 : 1;
                        animate opacity { duration: 250ms; }
                    }
                }

                if root.microsoft-login-state == 1: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    Text {
                        text: "浏览器应已自动打开。请在 Microsoft 页面输入下面的一次性代码完成登录。";
                        color: #37343c;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 66px;
                        background: code-hover.pressed ? #d8daeb : (code-hover.has-hover ? #e0e2f2 : #f7f6fb);
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: #c5c5d3;
                        animate background { duration: 90ms; }
                        code-hover := TouchArea {
                            clicked => { root.copy-text(root.microsoft-login-code); }
                        }
                        Text {
                            text: root.microsoft-login-code;
                            color: #34377d;
                            font-size: 24px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "点击代码即可复制。完成网页授权后，此窗口会自动继续。";
                        color: #77737d;
                        font-size: 11px;
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.microsoft-login-state == 3 || root.microsoft-login-state == 4: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    Rectangle {
                        height: 96px;
                        background: root.microsoft-login-state == 4 ? #fff2cc : #f8d7da;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: root.microsoft-login-state == 4 ? #c8a54c : #b86a72;
                        Text {
                            x: 14px;
                            y: 12px;
                            width: parent.width - 28px;
                            height: parent.height - 24px;
                            text: root.microsoft-login-message;
                            color: #37343c;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                    if root.microsoft-login-state == 4: Text {
                        text: "请为 HMCL-rs 注册 Microsoft Entra 公共客户端应用，并设置 HMCL_RS_MICROSOFT_CLIENT_ID 后重新启动。无需也不应填写 Client Secret。";
                        color: #66626c;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    alignment: end;
                    if root.microsoft-login-state == 1: DialogActionButton {
                        width: 132px;
                        text: "重新打开登录页面";
                        clicked => { root.open-url(root.microsoft-login-url); }
                    }
                    if root.microsoft-login-state == 3: DialogActionButton {
                        text: "重试";
                        text-color: #4f5fb4;
                        clicked => {
                            root.microsoft-login-state = 0;
                            root.microsoft-login-message = "正在连接 Microsoft…";
                            root.begin-microsoft-login();
                        }
                    }
                    DialogActionButton {
                        text: root.microsoft-login-state == 4 ? "确定" : "取消";
                        clicked => { root.close-microsoft-dialog(); }
                    }
                }
            }
        }
    }

    if root.account-dialog-mounted: ModalOverlay {
        shown: root.account-dialog-visible;
        available-height: root.height - 48px;

        Rectangle {
            width: 560px * parent.content-scale;
            height: (242px + 126px * root.account-dialog-advanced-progress) * parent.content-scale;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #e9e7ef;
            border-radius: 4px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 24px;
                padding-bottom: 16px;

                Text {
                    height: 32px;
                    text: "添加离线模式账户";
                    font-size: 20px;
                    font-weight: 700;
                    color: #242129;
                    vertical-alignment: center;
                }
                Rectangle { height: 10px; }

                VerticalLayout {
                    height: 52px;
                    HorizontalLayout {
                        height: 32px;
                        spacing: 15px;
                        Text {
                            text: "用户名";
                            width: 48px;
                            font-size: 13px;
                            color: #37343c;
                            vertical-alignment: center;
                        }
                        account-username-input := MaterialDialogField {
                            text <=> root.account-dialog-username;
                            placeholder: "建议使用英文字符、数字以及下划线命名，且长度不超过 16 个字符";
                            error: root.account-dialog-username == "";
                            accepted => { root.submit-account-dialog(); }
                        }
                    }
                    HorizontalLayout {
                        height: 20px;
                        Rectangle { width: 63px; }
                        if root.account-dialog-username == "": Text {
                            text: "必填项";
                            color: #ba1a1a;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { height: 10px; }

                Rectangle {
                    width: 120px;
                    height: 36px;
                    border-radius: 4px;
                    background: advanced-hover.pressed ? #00000014 : (advanced-hover.has-hover ? #0000000a : transparent);
                    animate background { duration: 90ms; }
                    advanced-hover := TouchArea {
                        clicked => { root.account-dialog-advanced = !root.account-dialog-advanced; }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        Text {
                            text: "高级设置";
                            color: #37343c;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        IconGlyph {
                            d: root.account-dialog-advanced ? Icons.arrow-drop-up : Icons.arrow-drop-down;
                            fill: #37343c;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                Rectangle {
                    height: 135px * root.account-dialog-advanced-progress;
                    opacity: root.account-dialog-advanced-progress;
                    clip: true;
                    VerticalLayout {
                        Rectangle { height: 15px; }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 15px;
                            Text {
                                text: "UUID";
                                width: 36px;
                                font-size: 13px;
                                color: #37343c;
                                vertical-alignment: center;
                            }
                            account-uuid-input := MaterialDialogField {
                                text <=> root.account-dialog-uuid;
                                placeholder: root.account-dialog-derived-uuid;
                                error: !root.account-dialog-uuid-valid;
                            }
                        }
                        if !root.account-dialog-uuid-valid: HorizontalLayout {
                            height: 20px;
                            Rectangle { width: 51px; }
                            Text {
                                text: "格式错误";
                                color: #ba1a1a;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                        if root.account-dialog-uuid-valid: Rectangle { height: 20px; }

                        Rectangle {
                            height: 68px;
                            background: #f6bd5a;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: #9b7838;
                            IconGlyph {
                                d: Icons.warning;
                                fill: #3d301c;
                                x: 8px;
                                y: 8px;
                                width: 14px;
                                height: 14px;
                            }
                            Text {
                                x: 28px;
                                y: 5px;
                                width: parent.width - 36px;
                                height: 20px;
                                text: "警告";
                                color: #3d301c;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Text {
                                x: 8px;
                                y: 26px;
                                width: parent.width - 16px;
                                height: parent.height - 28px;
                                text: "UUID 是 Minecraft 玩家的唯一标识符。每个启动器生成 UUID 的方式可能不同。通过将 UUID 修改为原启动器所生成的 UUID，你可以保证在切换启动器后，游戏还能将你的游戏角色识别为给定 UUID 所对应的角色，从而保留原角色的背包物品。UUID 选项为高级选项。除非你知道你在做什么，否则你不需要调整该选项。";
                                color: #3d301c;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 42px;
                    padding-top: 10px;
                    spacing: 8px;
                    alignment: end;
                    DialogActionButton {
                        text: "登录";
                        text-color: #4f5fb4;
                        enabled: root.account-dialog-username != ""
                            && root.account-dialog-uuid-valid;
                        clicked => { root.submit-account-dialog(); }
                    }
                    DialogActionButton {
                        text: "取消";
                        clicked => { root.close-account-dialog(); }
                    }
                }
            }
        }
    }

    if root.launch-progress-dialog-mounted: ModalOverlay {
        shown: root.launch-progress-dialog-visible;
        available-height: root.height - 48px;
        Rectangle {
            width: 500px * parent.content-scale;
            height: 300px * parent.content-scale;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #e9e7ef;
            border-radius: 4px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;
            VerticalLayout {
                VerticalLayout {
                    vertical-stretch: 1;
                    padding: 16px;
                    Text {
                        height: 20px;
                        text: "启动游戏";
                        font-size: 14px;
                        font-weight: 700;
                        color: #242129;
                    }
                    Rectangle { height: 12px; }
                    for row in root.launch-stage-lines: Rectangle {
                        height: 28px;
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 14px;
                                if row.state == 2: IconGlyph { d: Icons.check; fill: #242129; width: 14px; height: 14px; y: 7px; }
                                if row.state != 2: IconGlyph {
                                    d: Icons.arrow-forward;
                                    fill: row.state == 0 ? #8f8b96 : #242129;
                                    width: 14px;
                                    height: 14px;
                                    y: 7px;
                                }
                            }
                            Text {
                                text: row.label;
                                color: row.state == 0 ? #8f8b96 : #242129;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        height: 30px;
                        text: root.launch-progress-detail;
                        color: #65626d;
                        font-size: 11px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    height: 40px;
                    padding-right: 8px;
                    padding-bottom: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    DialogActionButton { text: "取消"; clicked => { root.cancel-launch(); } }
                }
            }
        }
    }

    if root.install-progress-dialog-mounted: ModalOverlay {
        shown: root.install-progress-dialog-visible;
        available-height: root.height - 48px;

        if !root.install-succeeded: Rectangle {
            width: 500px * parent.content-scale;
            height: (240px + root.install-stage-lines.length * 20px) * parent.content-scale;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #e9e7ef;
            border-radius: 4px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;

            VerticalLayout {
                VerticalLayout {
                    vertical-stretch: 1;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 16px;

                    Text {
                        height: 20px;
                        text: root.install-title;
                        font-size: 14px;
                        font-weight: 700;
                        color: #242129;
                        vertical-alignment: center;
                    }
                    Rectangle { height: 12px; }

                    for row in root.install-stage-lines: Rectangle {
                        height: 20px;
                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: 12px;
                            Rectangle {
                                width: 14px;
                                if row.state == 2: IconGlyph {
                                    d: Icons.check;
                                    fill: #242129;
                                    width: 14px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                }
                                if row.state != 2: IconGlyph {
                                    d: Icons.arrow-forward;
                                    fill: row.state == 0 ? #8f8b96 : #242129;
                                    width: 14px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            Text {
                                text: row.label + (row.show-count ? " - " + row.done + "/" + row.total : "");
                                color: row.state == 0 ? #8f8b96 : #242129;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        ListView {
                            for row in root.install-active-files: Rectangle {
                                height: 30px;
                                Text {
                                    x: 26px;
                                    width: parent.width - 26px;
                                    height: 18px;
                                    text: row.path;
                                    color: #302d35;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle {
                                    x: 26px;
                                    y: 20px;
                                    width: parent.width - 26px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: #d2d8ff;
                                    Rectangle {
                                        width: parent.width * (row.total > 0 ? row.downloaded / row.total : 0);
                                        height: 100%;
                                        border-radius: 2px;
                                        background: #4f5fb4;
                                        animate width { duration: 120ms; easing: linear; }
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 40px;
                    padding-left: 16px;
                    padding-right: 8px;
                    padding-bottom: 8px;
                    Text {
                        text: root.install-speed-text;
                        color: #302d35;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    DialogActionButton {
                        text: "取消";
                        clicked => { root.cancel-install(); }
                    }
                }
            }
        }

        if root.install-succeeded: Rectangle {
            width: 500px * parent.content-scale;
            height: 160px * parent.content-scale;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #e9e7ef;
            border-radius: 4px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 24px;
                padding-bottom: 16px;
                spacing: 16px;

                Rectangle {
                    width: 40px;
                    IconGlyph {
                        d: Icons.check-circle;
                        fill: #356a3e;
                        x: 0px;
                        y: 10px;
                        width: 40px;
                        height: 40px;
                    }
                }

                VerticalLayout {
                    Text {
                        height: 32px;
                        text: "完成";
                        font-size: 20px;
                        font-weight: 700;
                        color: #242129;
                        vertical-alignment: center;
                    }
                    Text {
                        height: 28px;
                        text: "安装成功";
                        font-size: 14px;
                        color: #302d35;
                        vertical-alignment: center;
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        height: 42px;
                        padding-top: 10px;
                        alignment: end;
                        DialogActionButton {
                            text: "确定";
                            text-color: #4f5fb4;
                            clicked => {
                                root.show-install-progress = false;
                                if root.install-return-to-download-list {
                                    root.mod-detail-open = false;
                                    root.show-mod-version-dialog = false;
                                } else {
                                    root.navigate-to(0, 3);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
