    function switch-settings-tab(next-tab: int) {
        if root.settings-tab-phase == 0 && next-tab != root.settings-tab {
            if root.animation-disabled {
                root.settings-tab = next-tab;
                return;
            }
            root.settings-tab-forward = next-tab > root.settings-tab;
            root.settings-tab-target = next-tab;
            root.settings-tab-phase = 1;
            settings-tab-midpoint.start();
        }
    }

    settings-tab-midpoint := Timer {
        interval: 100ms;
        triggered() => {
            root.settings-tab = root.settings-tab-target;
            root.settings-tab-phase = 2;
            self.stop();
            settings-tab-next-frame.start();
