import { ListView } from "std-widgets.slint";

export struct InstanceRow {
    id: string,
    subtitle: string,
    loader-kind: int,
}

export struct GameDirectoryRow {
    id: string,
    name: string,
    path: string,
}

export struct VersionRow {
    id: string,
    type-label: string,
    date: string,
}

export struct ModRow {
    project-id: string,
    title: string,
    description: string,
    downloads: string,
    categories: string,
    icon: image,
}

export struct ModVersionRow {
    header: bool,
    game-version: string,
    version-id: string,
    file-name: string,
    title: string,
    date: string,
    channel: string,
    loaders: string,
    expanded: bool,
}

export struct InstanceContentRow {
    file-name: string,
    name: string,
    detail: string,
    enabled: bool,
    directory: bool,
    online-icon: bool,
    icon: image,
}

export struct WorldRow {
    folder-name: string,
    name: string,
    game-version: string,
    last-played: string,
    // 被运行中的游戏占用（session.lock 锁着）：启动/导出/复制/删除全部禁用。
    locked: bool,
    has-icon: bool,
    icon: image,
    supports-quick-play: bool,
}

export struct BackupRow {
    file-name: string,
    world-name: string,
    time: string,
    game-version: string,
}

export struct DataPackRow {
    file-name: string,
    name: string,
    description: string,
    enabled: bool,
}

export struct JavaRow {
    version: string,
    detail: string,
    path: string,
}

export struct InstallStageRow {
    label: string,
    done: int,
    total: int,
    state: int,
    show-count: bool,
}

export struct InstallFileRow {
    path: string,
    downloaded: float,
    total: float,
}

