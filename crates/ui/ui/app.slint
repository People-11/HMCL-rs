    out property <string> archive: "M4 21Q3.175 21 2.5875 20.4125T2 19V6.525Q2 6.175 2.1125 5.85T2.45 5.25L3.7 3.75Q3.975 3.4 4.3875 3.2T5.275 3H18.725Q19.2 3 19.6125 3.2T20.3 3.75L21.55 5.25Q21.775 5.525 21.8875 5.85T22 6.525V19Q22 19.825 21.4125 20.4125T20 21H4ZM4.4 6H19.6L18.75 5H5.25L4.4 6ZM4 19H20V8H4V19ZM12 18 16 14 14.6 12.6 13 14.175V10H11V14.175L9.4 12.6 8 14 12 18Z";
}

component IconGlyph inherits Path {
    in property <string> d;
    commands: d;
    viewbox-width: 24;
    viewbox-height: 24;
}

component VersionChannelIcon inherits Rectangle {
    in property <bool> release;
    width: 18px;
    height: 18px;

    if root.release: Rectangle {
        border-radius: 9px;
        background: #2e7d32;
    }
    if !root.release: IconGlyph {
        d: "M12 2.5 22.5 21H1.5L12 2.5Z";
        fill: #ed6c02;
    }
    IconGlyph {
        d: root.release
            ? Icons.check
            : "M11 7H13V15H11V7ZM11 17H13V19H11V17Z";
        fill: white;
        width: root.release ? 12px : 16px;
        height: root.release ? 12px : 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// ponytail: 这两个按钮**故意不设 height**。Slint 的 HorizontalLayout 对"设了固定
// 高度"的子元素是顶端对齐(不是垂直居中)的——之前这里写了 height: 40px, 结果按钮
// 整体贴在 48px 标题栏的顶部, 图标虽然在按钮内部居中了, 看起来还是偏上 4px。
// 不设高度 => 被布局拉伸到整条的高度 => 里面按 parent.height 算的居中才是真居中。
// 悬停高亮因此改成一个固定尺寸、自己居中的内层方块, 否则会被拉成长条。
component TitleBarButton inherits Rectangle {
    in property <string> icon-path;
    in property <bool> dark-foreground: false;
    in property <color> icon-color: root.dark-foreground ? #302e37 : white;
    in property <color> hover-color: root.dark-foreground ? #00000014 : #ffffff30;
    in property <color> pressed-color: root.dark-foreground ? #00000024 : #ffffff4d;
    callback clicked();
    width: 28px;
    horizontal-stretch: 0;
    hover := TouchArea { clicked => { root.clicked(); } }
    Rectangle {
        width: 28px;
        height: 28px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: hover.pressed ? root.pressed-color : (hover.has-hover ? root.hover-color : transparent);
        animate background { duration: 100ms; }
    }
    IconGlyph {
        d: root.icon-path;
        fill: root.icon-color;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component InstanceIcon inherits Image {
    in property <int> loader-kind;
    source: root.loader-kind == 1 ? @image-url("assets/forge.png")
        : (root.loader-kind == 2 ? @image-url("assets/neoforge.png")
        : (root.loader-kind == 3 ? @image-url("assets/optifine.png")
        : (root.loader-kind == 4 ? @image-url("assets/fabric.png")
        : (root.loader-kind == 5 ? @image-url("assets/quilt.png")
        : @image-url("assets/grass.png")))));
    image-fit: contain;
}

component SmallIconButton inherits Rectangle {
    in property <string> icon-path;
    in property <color> icon-color: #555;
    in property <bool> enabled: true;
    callback clicked();
    width: 28px;
    opacity: root.enabled ? 1 : 0.35;
    hover := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    Rectangle {
        width: 28px;
        height: 28px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 5px;
        background: hover.pressed ? #00000024 : (hover.has-hover ? #00000014 : transparent);
        animate background { duration: 100ms; }
    }
    IconGlyph {
        d: root.icon-path;
        fill: root.icon-color;
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component ToolbarTextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    callback edited(string);
    callback accepted(string);
    height: 32px;
    background: input.has-focus ? #fbfbff : white;
    border-width: 1px;
    border-color: input.has-focus ? #6266d8 : #d5d5de;
    border-radius: 4px;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    if root.text == "": Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.placeholder;
        color: #8a8792;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: "";
        color: #3f3c46;
        selection-background-color: #6266d8;
        selection-foreground-color: white;
        font-size: 12px;
        vertical-alignment: center;
        edited => { root.edited(root.text); }
        accepted => { root.accepted(root.text); }
    }
}

global WindowMetrics {
    in-out property <length> window-width: 760px;
    in-out property <length> window-height: 480px;
}

component DropdownPopupSurface inherits Rectangle {
    in property <bool> revealed;
    in property <length> available-height;
    width: 100%;
    height: root.available-height;
    y: root.revealed ? 0px : -4px;
    opacity: root.revealed ? 1 : 0;
    background: white;
    border-radius: 4px;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000044;
    clip: true;
    animate y, opacity {
        duration: 140ms;
        easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
    }
    @children
}

component DownloadChoiceField inherits Rectangle {
    in property <[string]> options;
    in property <[string]> option-descriptions;
    in-out property <int> selected-index: 0;
    callback changed();
    property <length> option-item-height: root.option-descriptions.length > 0 ? 48px : 30px;
    property <length> content-popup-width: max(
        option-width-measure.preferred-width + 38px,
        description-width-measure.preferred-width + 24px
    );
    property <bool> popup-revealed: false;
    property <length> popup-width: max(root.width, min(root.content-popup-width, 280px));
    property <length> popup-height: min(root.options.length, 7) * root.option-item-height;
    height: 32px;
    min-width: 80px;
    preferred-width: min(choice-label.preferred-width + 30px, 220px);
    background: choice-hover.pressed ? #e7e7f0 : (choice-hover.has-hover ? #f5f5fa : white);
    border-width: 1px;
    border-color: #d5d5de;
    border-radius: 4px;
    animate background { duration: 100ms; }

    option-width-measure := VerticalLayout {
        visible: false;
        for option in root.options: Text { text: option; font-size: 12px; }
    }
    description-width-measure := VerticalLayout {
        visible: false;
        for description in root.option-descriptions: Text { text: description; font-size: 10px; }
    }

    choice-hover := TouchArea {
        clicked => {
            if root.options.length > 0 {
                root.popup-revealed = false;
                choice-popup.show();
                choice-popup-open.start();
            }
        }
    }
    choice-popup-open := Timer {
        interval: 16ms;
        triggered => {
            root.popup-revealed = true;
            self.stop();
        }
    }
    choice-popup-close := Timer {
        interval: 140ms;
        triggered => {
            choice-popup.close();
            self.stop();
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 5px;
        choice-label := Text {
            text: root.options.length > 0 && root.selected-index >= 0 && root.selected-index < root.options.length
                ? root.options[root.selected-index] : "";
            color: #302e37;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            width: 16px;
            alignment: center;
            IconGlyph { d: Icons.arrow-drop-down; fill: #55535d; width: 14px; height: 9px; }
        }
    }

    choice-popup := PopupWindow {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowMetrics.window-width;
        height: WindowMetrics.window-height;
        close-policy: no-auto-close;
        TouchArea {
            clicked => {
                root.popup-revealed = false;
                choice-popup-close.start();
            }
        }
        DropdownPopupSurface {
            x: max(8px, min(
                root.absolute-position.x + root.width - root.popup-width,
                WindowMetrics.window-width - root.popup-width - 8px
            ));
            y: max(8px, min(
                root.absolute-position.y + root.height,
                WindowMetrics.window-height - root.popup-height - 8px
            ));
            width: root.popup-width;
            revealed: root.popup-revealed;
            available-height: root.popup-height;
            ListView {
                for option[i] in root.options: Rectangle {
                    height: root.option-item-height;
                    background: option-hover.pressed ? #dedff0
                        : (option-hover.has-hover ? #f0f0fa : transparent);
                    option-hover := TouchArea {
                        clicked => {
                            root.selected-index = i;
                            root.changed();
                            root.popup-revealed = false;
                            choice-popup-close.start();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: option;
                                color: i == root.selected-index ? #5257c4 : #333;
                                font-size: 12px;
                                overflow: elide;
                            }
                            if i < root.option-descriptions.length && root.option-descriptions[i] != "": Text {
                                text: root.option-descriptions[i];
                                color: i == root.selected-index ? #6670b7 : #6b6872;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                        if i == root.selected-index: IconGlyph {
                            d: Icons.check;
                            fill: #5361bb;
                            width: 15px;
                            height: 15px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }
}

component DownloadInstanceField inherits Rectangle {
    in property <[InstanceRow]> instances;
    in-out property <int> selected-index: -1;
    callback changed();
    property <length> content-popup-width: instance-width-measure.preferred-width + 66px;
    property <bool> popup-revealed: false;
    property <length> popup-width: max(root.width, min(root.content-popup-width, 280px));
    property <length> popup-height: min(root.instances.length, 7) * 34px;
    height: 32px;
    background: instance-hover.pressed ? #e7e7f0 : (instance-hover.has-hover ? #f5f5fa : white);
    border-width: 1px;
    border-color: #d5d5de;
    border-radius: 4px;
    animate background { duration: 100ms; }

    instance-width-measure := VerticalLayout {
        visible: false;
        for instance in root.instances: Text { text: instance.id; font-size: 12px; }
    }

    instance-hover := TouchArea {
        clicked => {
            if root.instances.length > 0 {
                root.popup-revealed = false;
                instance-popup.show();
                instance-popup-open.start();
            }
        }
    }
    instance-popup-open := Timer {
        interval: 16ms;
        triggered => {
            root.popup-revealed = true;
            self.stop();
        }
    }
    instance-popup-close := Timer {
        interval: 140ms;
        triggered => {
            instance-popup.close();
            self.stop();
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 5px;
        Text {
            text: root.selected-index >= 0 && root.selected-index < root.instances.length
                ? root.instances[root.selected-index].id : "未选择";
            color: #302e37;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            width: 16px;
            alignment: center;
            IconGlyph { d: Icons.arrow-drop-down; fill: #55535d; width: 14px; height: 9px; }
        }
    }

    instance-popup := PopupWindow {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowMetrics.window-width;
        height: WindowMetrics.window-height;
        close-policy: no-auto-close;
        TouchArea {
            clicked => {
                root.popup-revealed = false;
                instance-popup-close.start();
            }
        }
        DropdownPopupSurface {
            x: max(8px, min(
                root.absolute-position.x,
                WindowMetrics.window-width - root.popup-width - 8px
            ));
            y: max(8px, min(
                root.absolute-position.y + root.height,
                WindowMetrics.window-height - root.popup-height - 8px
            ));
            width: root.popup-width;
            revealed: root.popup-revealed;
            available-height: root.popup-height;
            ListView {
                for instance[i] in root.instances: Rectangle {
                    height: 34px;
                    background: instance-option-hover.pressed ? #dedff0
                        : (instance-option-hover.has-hover ? #f0f0fa : transparent);
                    instance-option-hover := TouchArea {
                        clicked => {
                            root.selected-index = i;
                            root.changed();
                            root.popup-revealed = false;
                            instance-popup-close.start();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        IconGlyph { d: Icons.gamepad; fill: #55535d; width: 17px; height: 17px; y: (parent.height - self.height) / 2; }
                        Text {
                            text: instance.id;
                            color: i == root.selected-index ? #5361bb : #302e37;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if i == root.selected-index: IconGlyph {
                            d: Icons.check;
                            fill: #5361bb;
                            width: 15px;
                            height: 15px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }
}

component CompactButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    min-width: 52px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.enabled ? #aeb2ce : #d3d4df;
    opacity: root.enabled ? 1 : 0.45;
    background: compact-hover.pressed ? #dcddea : (compact-hover.has-hover ? #eeeef6 : #ffffff55);
    animate background { duration: 90ms; }
    compact-hover := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: #4f59b2;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

component ProjectTag inherits Rectangle {
    in property <string> text;
    height: 18px;
    width: min(tag-label.preferred-width + 10px, 220px);
    background: #e3e5f9;
    border-radius: 3px;

    tag-label := Text {
        x: 5px;
        width: parent.width - 10px;
        height: 100%;
        text: root.text;
        font-size: 10px;
        color: #5257c4;
        vertical-alignment: center;
        overflow: elide;
    }
}

component SettingsToolbarButton inherits Rectangle {
    in property <string> icon-path;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    min-width: toolbar-label.preferred-width + 44px;
    opacity: root.enabled ? 1 : 0.35;
    toolbar-hover := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Rectangle {
        width: parent.width;
        height: 36px;
        y: (parent.height - self.height) / 2;
        border-radius: 5px;
        background: toolbar-hover.pressed ? #00000024 : (toolbar-hover.has-hover ? #00000014 : transparent);
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        VerticalLayout {
            width: 17px;
            alignment: center;
            IconGlyph { d: root.icon-path; fill: #302e37; width: 17px; height: 17px; }
        }
        toolbar-label := Text {
            text: root.label;
            color: #302e37;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

component JavaDownloadButton inherits SettingsToolbarButton {
    callback selected(int);
    property <[string]> java-options: ["Java 8（旧版游戏）", "Java 16", "Java 17", "Java 21", "Java 25"];
    property <length> content-popup-width: java-width-measure.preferred-width + 28px;
    property <bool> popup-revealed: false;
    property <length> popup-width: min(root.content-popup-width, 240px);
    property <length> popup-height: root.java-options.length * 30px;
    icon-path: Icons.download;
    label: "下载 Java";
    java-width-measure := VerticalLayout {
        visible: false;
        for option in root.java-options: Text { text: option; font-size: 12px; }
    }
    clicked => {
        root.popup-revealed = false;
        java-menu.show();
        java-menu-open.start();
    }
    java-menu-open := Timer {
        interval: 16ms;
        triggered => {
            root.popup-revealed = true;
            self.stop();
        }
    }
    java-menu-close := Timer {
        interval: 140ms;
        triggered => {
            java-menu.close();
            self.stop();
        }
    }
    java-menu := PopupWindow {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowMetrics.window-width;
        height: WindowMetrics.window-height;
        close-policy: no-auto-close;
        TouchArea {
            clicked => {
                root.popup-revealed = false;
                java-menu-close.start();
            }
        }
        DropdownPopupSurface {
            x: max(8px, min(
                root.absolute-position.x,
                WindowMetrics.window-width - root.popup-width - 8px
            ));
            y: max(8px, min(
                root.absolute-position.y + root.height,
                WindowMetrics.window-height - root.popup-height - 8px
            ));
            width: root.popup-width;
            revealed: root.popup-revealed;
            available-height: root.popup-height;
            VerticalLayout {
                for label[i] in root.java-options: Rectangle {
                    height: 30px;
                    background: item-hover.pressed ? #dedff0 : (item-hover.has-hover ? #f0f0fa : transparent);
                    item-hover := TouchArea {
                        clicked => {
                            root.selected(i);
                            root.popup-revealed = false;
                            java-menu-close.start();
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: label;
                        color: #302e37;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component MaterialDialogField inherits Rectangle {
    in-out property <string> text <=> field-input.text;
    in property <string> placeholder;
    in property <bool> error: false;
    in property <bool> enabled: true;
    in property <bool> password-mode: false;
    out property <bool> has-focus: field-input.has-focus;
    callback edited();
    callback accepted();
    height: 32px;
    background: root.enabled ? (root.has-focus ? #fbfbff : white) : #f1f1f5;
    border-width: 1px;
    border-color: root.error ? #ba1a1a : (root.has-focus ? #6266d8 : #d5d5de);
    border-radius: 4px;
    animate background, border-color { duration: 100ms; }

    if root.text == "": Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.placeholder;
        color: #8a8792;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    field-input := TextInput {
        enabled: root.enabled;
        input-type: root.password-mode ? InputType.password : InputType.text;
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: "";
        color: #3f3c46;
        selection-background-color: #6266d8;
        selection-foreground-color: white;
        font-size: 12px;
        vertical-alignment: center;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
}

component DialogActionButton inherits Rectangle {
    in property <string> text;
    in property <color> text-color: #514f59;
    in property <bool> enabled: true;
    callback clicked();
    width: 56px;
    height: 32px;
    border-radius: 4px;
    background: action-hover.pressed ? #00000018 : (action-hover.has-hover ? #0000000c : transparent);
    animate background { duration: 90ms; }
    action-hover := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        color: root.enabled ? root.text-color : #9f9ca7;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ModalOverlay inherits Rectangle {
    in property <bool> shown;
    in property <length> available-height;
    out property <float> content-scale: 1;
    width: 100%;
    height: root.available-height;
    y: 48px;
    background: #0000001a;
    states [
        hidden when !root.shown: {
            opacity: 0;
            root.content-scale: 0.8;
            in {
                animate opacity, root.content-scale {
                    duration: 200ms;
                    easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
                }
            }
            out {
                animate opacity, root.content-scale {
                    duration: 400ms;
                    easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
                }
            }
        }
    ]
    TouchArea {}
    @children
}

component NavGroupLabel inherits Text {
    color: #55597a;
    font-size: 12px;
    font-weight: 600;
}

component NavItem inherits Rectangle {
    in property <string> icon-path;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();
    height: subtitle == "" ? 32px : 44px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.4;
    background: hover.pressed ? #ffffffd0 : (selected ? #ffffffb0 : (hover.has-hover ? #ffffff70 : #ffffff00));
    animate background { duration: 100ms; }
    hover := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 10px;
        padding-right: 6px;
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            IconGlyph { d: root.icon-path; fill: #3a3d52; width: 20px; height: 20px; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.title; font-size: 13px; color: #1a1a2a; }
            if root.subtitle != "": Text { text: root.subtitle; font-size: 10px; color: #757994; }
        }
    }
}

component GameDirectoryNavItem inherits Rectangle {
    in property <string> title;
    in property <string> path;
    in property <bool> selected: false;
    callback clicked();
    callback more-clicked(length);
    height: 50px;
    border-radius: 6px;
    background: item-hover.pressed ? #ffffffd0
        : (root.selected ? #ffffffb0 : (item-hover.has-hover ? #ffffff70 : transparent));
    animate background { duration: 100ms; }
    item-hover := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout {
            width: 20px;
            alignment: center;
            IconGlyph { d: Icons.folder; fill: #3a3d52; width: 20px; height: 20px; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.title;
                font-size: 13px;
                color: #1a1a2a;
                overflow: elide;
            }
            Text {
                text: root.path;
                font-size: 10px;
                color: #757994;
                overflow: elide;
            }
        }
        more-button := SmallIconButton {
            icon-path: Icons.more-vert;
            clicked => {
                root.more-clicked(more-button.absolute-position.y);
            }
        }
    }
}

component ManagementMenuItem inherits Rectangle {
    in property <string> icon-path;
    in property <string> text;
    in property <bool> dangerous: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    opacity: root.enabled ? 1 : 0.4;
    background: item-hover.pressed ? #dcddea : (item-hover.has-hover ? #e9e9f2 : transparent);
    item-hover := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            IconGlyph {
                d: root.icon-path;
                fill: root.dangerous ? #ba1a1a : #302e37;
                width: 18px;
                height: 18px;
            }
        }
        Text {
            text: root.text;
            color: root.dangerous ? #ba1a1a : #302e37;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

component InstallerCard inherits Rectangle {
    horizontal-stretch: 0;
    height: 126px;
    in property <image> icon;
    in property <string> name;
    in property <string> version;
    in property <bool> enabled: true;
    in property <bool> show-arrow: true;
    in property <bool> selected: false;
    callback clicked();
    background: !root.enabled ? #f4f4f7
        : (hover.pressed ? #e7e8f3 : (hover.has-hover ? #f4f5fb : white));
    border-width: 1px;
    border-color: root.selected ? #7378dc : #e0dfe7;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.62;
    drop-shadow-blur: 5px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: #00000029;
    animate background, border-color { duration: 100ms; }
    hover := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 2px;
        alignment: center;
        HorizontalLayout {
            height: 36px;
            alignment: center;
            Image { source: root.icon; width: 32px; height: 32px; image-fit: contain; }
        }
        Text {
            width: 100%;
            height: 18px;
            text: root.name;
            font-size: 13px;
            font-weight: 600;
            color: root.enabled ? #282631 : #77747d;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            width: 100%;
            height: 16px;
            text: root.version;
            font-size: 11px;
            color: root.selected ? #5961bd : (root.enabled ? #66636d : #99969f);
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            height: 18px;
            alignment: center;
            if root.enabled && root.show-arrow: IconGlyph {
                d: Icons.arrow-forward;
                fill: #595fbd;
                width: 16px;
                height: 16px;
            }
        }
    }
}


component InheritButton inherits Rectangle {
    in-out property <bool> overridden;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: transparent;
    IconGlyph {
        d: root.overridden ? Icons.tune : Icons.public-icon;
        fill: root.overridden ? #5968c2 : #cccc33;
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component SettingsRowShell inherits Rectangle {
    in property <string> label;
    in property <string> sublabel: "";
    in-out property <bool> overridden;
    height: root.sublabel == "" ? 48px : 64px;
    background: white;
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.label; font-size: 12px; color: #242129; }
            if root.sublabel != "": Text {
                text: root.sublabel;
                font-size: 10px;
                color: #686571;
                wrap: word-wrap;
            }
        }
        @children
        VerticalLayout {
            alignment: center;
            InheritButton { overridden <=> root.overridden; }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: #d4d3dc; }
}

component SettingsBoolRow inherits SettingsRowShell {
    in-out property <bool> value;
    in property <bool> enabled: true;
    in property <bool> auto-inherit: false;
    in property <bool> inherited-value: false;
    callback edited();
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 34px;
            height: 18px;
            border-radius: 9px;
            background: root.value ? #6266d8 : #c9c7d1;
            animate background { duration: 90ms; }
            switch-hover := TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.value = !root.value;
                    root.overridden = !root.auto-inherit || root.value != root.inherited-value;
                    root.edited();
                }
            }
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: white;
                x: root.value ? parent.width - self.width - 2px : 2px;
                y: 2px;
                animate x { duration: 90ms; }
            }
        }
    }
}

component SettingsTextRow inherits SettingsRowShell {
    in-out property <string> value;
    in property <string> placeholder: "";
    in property <bool> auto-inherit: false;
    in property <string> inherited-value: "";
    callback edited();
    VerticalLayout {
        alignment: center;
        width: 220px;
        MaterialDialogField {
            width: 100%;
            text <=> root.value;
            placeholder: root.placeholder;
            edited => {
                root.overridden = !root.auto-inherit || root.value != root.inherited-value;
                root.edited();
            }
        }
    }
}

component MaterialSwitch inherits Rectangle {
    in-out property <bool> checked;
    callback edited();
    width: 38px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? #5968c2 : #dedde7;
    animate background { duration: 100ms; }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.edited();
        }
    }
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? #ffffff : #85838e;
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000045;
        animate x, background { duration: 100ms; easing: ease; }
    }
}

component LauncherSettingLine inherits Rectangle {
    in property <string> label;
    in property <string> sublabel: "";
    in property <bool> enabled: true;
    height: root.sublabel == "" ? 48px : 64px;
    background: line-hover.pressed ? #0000000a : (line-hover.has-hover ? #ffffff25 : #ffffff00);
    animate background { duration: 90ms; }
    callback clicked();
    line-hover := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 15px;
        padding-right: 15px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.label; color: #2f2c36; font-size: 13px; }
            if root.sublabel != "": Text {
                text: root.sublabel;
                color: #5f5c68;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
        @children
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: #c9c8d0; }
}

component LauncherToggleLine inherits LauncherSettingLine {
    in-out property <bool> value;
    callback edited();
    clicked => {
        root.value = !root.value;
        root.edited();
    }
    VerticalLayout {
        alignment: center;
        MaterialSwitch {
            checked <=> root.value;
            edited => { root.edited(); }
        }
    }
}

component LauncherChoiceLine inherits LauncherSettingLine {
    in property <[string]> options;
    in property <[string]> option-descriptions;
    in-out property <int> selected-index;
    in property <bool> show-inherit: false;
    in-out property <bool> overridden: false;
    in property <bool> auto-inherit: false;
    in property <int> inherited-index: 0;
    callback edited();
    VerticalLayout {
        width: root.show-inherit ? 186px : 154px;
        alignment: center;
        HorizontalLayout {
            height: 32px;
            spacing: 6px;
            alignment: end;
            DownloadChoiceField {
                horizontal-stretch: 1;
                options: root.options;
                option-descriptions: root.option-descriptions;
                selected-index <=> root.selected-index;
                changed => {
                    if root.show-inherit {
                        root.overridden = !root.auto-inherit || root.selected-index != root.inherited-index;
                    }
                    root.edited();
                }
            }
            if root.show-inherit: VerticalLayout {
                alignment: center;
                InheritButton { overridden <=> root.overridden; }
            }
        }
    }
}

component LauncherTextLine inherits LauncherSettingLine {
    in-out property <string> value;
    in property <string> placeholder: "";
    callback edited();
    VerticalLayout {
        width: 210px;
        alignment: center;
        MaterialDialogField {
            width: 100%;
            text <=> root.value;
            placeholder: root.placeholder;
            enabled: root.enabled;
            edited => { root.edited(); }
        }
    }
}

component LauncherValueLine inherits LauncherSettingLine {
    in property <string> value;
    VerticalLayout {
        alignment: center;
        Text {
            text: root.value == "" ? "—" : root.value;
            color: root.value == "" ? #7a7783 : #55535c;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

/// 内容区里那种白底圆角卡片：工具栏条、列表容器、空态框都是它。
/// 之前这套属性在文件里被逐字抄了 22 遍。
component ContentCard inherits Rectangle {
    background: white;
    border-radius: 4px;
    clip: true;
    drop-shadow-blur: 5px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: #0000002b;
    @children
}

component SettingsCardTitle inherits Text {
    height: 24px;
    color: #35323c;
    font-size: 12px;
    vertical-alignment: center;
}

component SettingsGroup inherits ContentCard {
    height: group-content.preferred-height;
    group-content := VerticalLayout { @children }
}

component SettingsSublist inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> description: "";
    in property <length> content-height;
    in property <bool> show-inherit: false;
    in-out property <bool> overridden: false;
    in-out property <bool> expanded: false;
    property <length> header-height: root.subtitle == "" ? 48px : 64px;
    property <length> target-height: root.header-height + (root.expanded ? root.content-height : 0px);
    property <length> animated-height: root.target-height;
    min-height: root.animated-height;
    preferred-height: root.animated-height;
    max-height: root.animated-height;
    background: white;
    clip: true;
    animate animated-height { duration: 180ms; easing: ease-out; }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.header-height;
        z: 2;
        background: sublist-hover.pressed ? #e2e3ec : (sublist-hover.has-hover ? #f1f1f6 : transparent);
        animate background { duration: 90ms; }
        sublist-hover := TouchArea { clicked => { root.expanded = !root.expanded; } }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: root.title; color: #292731; font-size: 12px; }
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    color: #696671;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
            if root.description != "": Text {
                text: root.description;
                color: #66636e;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
            if root.show-inherit: VerticalLayout {
                alignment: center;
                InheritButton { overridden <=> root.overridden; }
            }
            VerticalLayout {
                alignment: center;
                IconGlyph {
                    d: root.expanded ? Icons.arrow-drop-up : Icons.arrow-drop-down;
                    fill: #66636e;
                    width: 20px;
                    height: 20px;
                }
            }
        }
    }

    Rectangle {
        x: 0;
        y: root.header-height;
        width: root.width;
        height: root.content-height;
        z: 1;
        background: #ececf2;
        VerticalLayout { @children }
    }
}

component SettingsRadioList inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected-index;
    callback edited();
    height: root.options.length * 44px;
    background: #ececf2;

    VerticalLayout {
        for option[i] in root.options: Rectangle {
            height: 44px;
            background: radio-hover.pressed ? #dcdde7 : (radio-hover.has-hover ? #e5e5ed : transparent);
            radio-hover := TouchArea {
                clicked => {
                    root.selected-index = i;
                    root.edited();
                }
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        border-width: 2px;
                        border-color: i == root.selected-index ? #5968c2 : #77747f;
                        if i == root.selected-index: Rectangle {
                            width: 8px;
                            height: 8px;
                            x: 5px;
                            y: 5px;
                            border-radius: 4px;
                            background: #5968c2;
                        }
                    }
                }
                Text {
                    text: option;
                    color: #302e37;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    no-frame: true;
    resize-border-width: 0px;
    title: "HMCL-rs";
    width: 760px;
    height: 480px;
    icon: @image-url("assets/icon.png");
    init => {
        WindowMetrics.window-width = root.width;
        WindowMetrics.window-height = root.height;
    }
    changed width => { WindowMetrics.window-width = root.width; }
    changed height => { WindowMetrics.window-height = root.height; }

    property <int> page: 0;
    property <int> page-transition-phase: 0;
    property <int> page-transition-kind: 0;
    property <int> page-transition-target: 0;
    property <bool> page-transition-active: root.page-transition-phase != 0;
    property <bool> loading-pulse: false;

    function navigate-to(next-page: int, kind: int) {
        if root.page-transition-phase == 0 && next-page != root.page {
            if root.animation-disabled {
                root.page = next-page;
                return;
            }
            root.page-transition-target = next-page;
            root.page-transition-kind = kind;
            root.page-transition-phase = 1;
            page-transition-midpoint.start();
        }
    }

    page-transition-midpoint := Timer {
        interval: 100ms;
        running: false;
        triggered() => {
            root.page = root.page-transition-target;
            root.page-transition-phase = 2;
            self.stop();
            page-transition-next-frame.start();
        }
    }
    page-transition-next-frame := Timer {
        // JavaFX's TransitionPane uses Platform.runLater here. One 60 Hz frame makes
        // the hidden next-page state observable before its `out` transition starts.
        interval: 16ms;
        running: false;
        triggered() => {
            root.page-transition-phase = 3;
            self.stop();
            page-transition-finished.start();
        }
    }
    page-transition-finished := Timer {
        interval: 100ms;
        running: false;
        triggered() => {
            root.page-transition-phase = 0;
            self.stop();
        }
    }
    world-menu-open-timer := Timer {
        interval: 16ms;
        triggered => {
            root.world-menu-revealed = true;
            self.stop();
        }
    }
    world-menu-close-timer := Timer {
        interval: 140ms;
        triggered => {
            root.world-menu-open = false;
            self.stop();
        }
    }
    game-directory-menu-open-timer := Timer {
        interval: 16ms;
        triggered => {
            root.game-directory-menu-revealed = true;
            self.stop();
        }
    }
    game-directory-menu-close-timer := Timer {
        interval: 140ms;
        triggered => {
            root.game-directory-menu-open = false;
            self.stop();
        }
    }
    instance-menu-open-timer := Timer {
        interval: 16ms;
        triggered => {
            root.instance-menu-revealed = true;
            self.stop();
        }
    }
    instance-menu-close-timer := Timer {
        interval: 140ms;
        triggered => {
            root.instance-menu-open = false;
            self.stop();
        }
    }
    loading-pulse-timer := Timer {
        interval: 650ms;
        running: root.remote-loading || root.loader-versions-loading || root.show-install-progress
            || root.show-launch-progress || (root.microsoft-dialog-mounted
            && (root.microsoft-login-state == 0 || root.microsoft-login-state == 2))
            || (root.authlib-dialog-mounted && root.authlib-dialog-state == 3);
        triggered() => { root.loading-pulse = !root.loading-pulse; }
    }

    in property <[InstanceRow]> instances;
    in property <[GameDirectoryRow]> game-directories;
    in-out property <int> selected-game-directory-index: 0;
    in property <[string]> accounts;
    in property <[string]> account-kinds;
    in property <[image]> account-avatars;
    in property <[bool]> account-has-avatars;
    in property <[string]> auth-server-names;
    in property <[string]> auth-server-urls;
    in property <[bool]> auth-server-non-email-login;
    in-out property <int> selected-account-index: -1;
    in-out property <int> selected-instance-index: -1;
    in property <string> status-text: "就绪";
    in-out property <string> filter-text: "";

    in property <[VersionRow]> remote-versions;
    in property <bool> remote-loading: false;
    in-out property <string> remote-filter-name: "";
    in-out property <int> remote-type-index: 0;
    property <[string]> remote-type-labels: ["正式版", "快照", "愚人节版", "远古版", "全部"];

    in-out property <int> download-section: 0;
    in-out property <int> download-tab: 0;
    property <int> download-section-target: 0;
    property <int> download-section-phase: 0;
    property <bool> download-section-forward: true;
    in-out property <bool> download-return-instance: false;
    // 0 = 模组(project_type=mod), 1 = 资源包(resourcepack), 2 = 光影(shader)——
    // 三者共用同一块 UI(download-tab == 1)和同一套搜索/安装回调, 只是搜索时的
    // project_type、装模组时的目标子目录(mods/resourcepacks/shaderpacks)不同,
    // 不为每一种都单独抄一遍 Slint 内容块。
    in-out property <int> mod-search-kind: 0;
    property <string> mod-search-kind-label: root.mod-search-kind == 3 ? "整合包"
        : (root.mod-search-kind == 1 ? "资源包" : (root.mod-search-kind == 2 ? "光影" : "模组"));
    in property <[ModRow]> mod-search-results;
    in property <bool> mod-search-loading: false;
    in-out property <string> mod-search-query: "";
    property <length> mod-search-scroll-y: 0px;
    in property <int> mod-search-page: 0;
    in property <bool> mod-search-has-more: false;
    in property <[string]> mod-game-version-options: ["全部"];
    in-out property <int> mod-game-version-index: 0;
    in property <[string]> mod-category-options: ["全部"];
    in-out property <int> mod-category-index: 0;
    property <[string]> mod-sort-options: ["热度", "最新发布", "最近更新", "下载量"];
    in-out property <int> mod-sort-index: 0;
    in-out property <bool> mod-detail-open: false;
    in-out property <string> mod-detail-project-id: "";
    in-out property <string> mod-detail-title: "";
    in-out property <string> mod-detail-description: "";
    in-out property <string> mod-detail-categories: "";
    in-out property <image> mod-detail-icon;
    in property <[ModVersionRow]> mod-detail-versions;
    in property <bool> mod-detail-loading: false;
    in-out property <bool> show-mod-version-dialog: false;
    in-out property <string> selected-mod-version-id: "";
    in-out property <string> selected-mod-file-name: "";
    in-out property <string> selected-mod-version-title: "";
    in-out property <string> selected-mod-version-detail: "";
    callback search-mods();
    callback load-more-mods();
    callback open-mod-project(string);
    callback toggle-mod-version-group(string);
    callback install-mod-version(string, string);
    callback suggest-instance-name(string) -> string;
    callback instance-name-exists(string) -> bool;

    function apply-download-section(next-section: int) {
        root.download-section = next-section;
        root.mod-detail-open = false;
        root.show-mod-version-dialog = false;
        if next-section == 0 {
            root.download-tab = 0;
            if root.remote-versions.length == 0 { root.refresh-remote-versions(); }
        } else {
            root.download-tab = 1;
            root.mod-search-kind = next-section == 1 ? 3 : next-section - 2;
            root.mod-search-scroll-y = 0px;
            root.mod-category-index = 0;
            if root.remote-versions.length == 0 { root.refresh-remote-versions(); }
            root.search-mods();
        }
    }

    function switch-download-section(next-section: int) {
        if root.download-section-phase == 0
            && (next-section != root.download-section || root.download-tab == 2) {
            if root.animation-disabled {
                root.apply-download-section(next-section);
                return;
            }
            root.download-section-forward = next-section >= root.download-section;
            root.download-section-target = next-section;
            root.download-section-phase = 1;
            download-section-midpoint.start();
        }
    }

    download-section-midpoint := Timer {
        interval: 100ms;
        triggered() => {
            root.apply-download-section(root.download-section-target);
            root.download-section-phase = 2;
            self.stop();
            download-section-next-frame.start();
        }
    }
    download-section-next-frame := Timer {
        interval: 16ms;
        triggered() => {
            root.download-section-phase = 3;
            self.stop();
            download-section-finished.start();
        }
    }
    download-section-finished := Timer {
        interval: 100ms;
        triggered() => {
            root.download-section-phase = 0;
            self.stop();
        }
    }

